<TABLE WIDTH="627" BORDER="0" CELLPADDING="0" CELLSPACING="0">
	<TR><TD COLSPAN="4" WIDTH="627"><IMG SRC="/img/pix.gif" WIDTH="1" HEIGHT="10"></TD></TR>
