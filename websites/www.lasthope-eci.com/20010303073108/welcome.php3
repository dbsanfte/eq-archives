			      <tr>
			        <td background="images/mt_bg.gif" bgColor="#FFCC00"><small><font face="Arial">February 20, 2001 <strong>Epic Obtained for Fenya</strong></font></small></td>
			        <td background="images/mt_bg.gif" bgColor="#FFCC00"><font face="Arial"><strong><p
			        align="right"><a href="news.php3?command=EDIT&id=35"><img src="images/edit_button.gif" alt="Edit this stroy" WIDTH="21" HEIGHT="17" border="0"></a><a href="delete_news.php3?id=35&a=39"><img src="images/delete_button.gif" alt="Delete this story" WIDTH="21"
