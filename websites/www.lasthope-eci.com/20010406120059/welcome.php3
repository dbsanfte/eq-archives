			  <tr>
			    <td bgColor="#000000" width="100%" colspan="2"><table border="0" cellPadding="2"
			    cellSpacing="0" width="100%">
			      <tr>
			        <td background="images/mt_bg.gif" bgColor="#FFCC00"><small><font face="Arial">January 29, 2001 <strong>THANK YOU</strong></font></small></td>
			        <td background="images/mt_bg.gif" bgColor="#FFCC00"><font face="Arial"><strong><p
			        align="right"><a href="news.php3?command=EDIT&id=31"><img src="images/edit_button.gif" alt="Edit this stroy" WIDTH="21" HEIGHT="17" border="0"></a><a href="delete_news.php3?id=31&a=11"><img src="images/delete_button.gif" alt="Delete this story" WIDTH="21"
			        HEIGHT="17" border="0"></a></strong></font></td>
			      </tr>
			    </table>
			    </td>
			  </tr>
			  <tr>
			    <td width="100%" colspan="2"><font face="Arial">Thank you to my many friends for help with Ragefire today.  Anyone need a res?</font></td>
			  </tr>
