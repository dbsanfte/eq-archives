var off_bulb = '<img src="http://www.fear.net/fates/ubb/off.gif" border="0" alt="" />';

function bulbize(post_j) {
	if ((post_j > session_j) && (post_j != 0)) {
		return(on_bulb);
	}  else {
		return(off_bulb);
	}
}
//-->
</script>

