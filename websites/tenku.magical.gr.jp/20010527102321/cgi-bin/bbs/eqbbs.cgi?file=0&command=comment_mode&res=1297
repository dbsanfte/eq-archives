<SCRIPT><!--
D=new Date();
T=D.getTime()/1000;
function chkTime(t) {
	var j=(T-t)/60/10;
	if (j<=180) {
		if (j < 0) {
			j = 0;
		}
		return j;
	}
	return -1;
}
function chkNew(t,n) {
	var j = chkTime(t);
	if (j >= 0) {
		j = (255 - Math.floor(j));
		if (j < 16) {
			j = "0" + j.toString(16);
		}
		else {
			j = j.toString(16);
		}
		document.write("<FONT COLOR=#"+j+"0000><I><B>New</B></I></FONT>");
	}
}
function chkFold(t,i) {
	if (chkTime(t) >= 0) {
		hide.item(i).style.display = "block";
	}
}
function fold(i)
{
	if(document.all) {
		hide.item(i).style.display = hide.item(i).style.display == "block" ? "none" : "block";
	}
}

if ((navigator.appName=="Microsoft Internet Explorer") && (navigator.appVersion.charAt(0) >= 4) && (navigator.appVersion.toUpperCase().indexOf("WIN",0) != -1)) {
	document.write('<STYLE TYPE="text/css"><!-');
	document.write('-');
	document.write('#hide {display:none}');
	document.write('-');
	document.write('-></STYLE>');
}
//--></SCRIPT>
