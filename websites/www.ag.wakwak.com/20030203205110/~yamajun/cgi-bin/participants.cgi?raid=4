function getCookie(key,  tmp1, tmp2, xx1, xx2, xx3) {
    tmp1 = " " + document.cookie + ";";
    xx1 = xx2 = 0;
    len = tmp1.length;
    while (xx1 < len) {
        xx2 = tmp1.indexOf(";", xx1);
        tmp2 = tmp1.substring(xx1 + 1, xx2);
        xx3 = tmp2.indexOf("=");
        if (tmp2.substring(0, xx3) == key) {
            return(unescape(tmp2.substring(xx3 + 1, xx2 - xx1 - 1)));
        }
        xx1 = xx2 + 1;
    }
    return("");
}
function setCookie(key, val, tmp) {
    tmp = key + "=" + escape(val) + "; ";
    tmp += "path=/~yamajun/cgi-bin; ";
    tmp += "expires=Fri, 31-Dec-2030 23:59:59; ";
    document.cookie = tmp;
}

function update() {
	if (document.f.name.value == null || document.f.name.value == "") { alert('名前を入力してください'); return; }
	setCookie('Name', document.f.name.value);
	for(i = 0; i < document.f.elements[2].options.length; i++) {
		if (document.f.elements[2].options[i].selected == true) {
			setCookie('Class', document.f.elements[2].options[i].value);
			break;
		}
	}
	for(i = 0; i < document.f.level.options.length; i++) {
		if (document.f.level.options[i].selected == true) {
			setCookie('Level', document.f.level.options[i].value);
			break;
		}
	}
	document.f.submit();
}
//-->
