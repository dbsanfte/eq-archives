<html>
<head><title>Jon's Cell Phone Message Page</title></head>
<body>

<h3 align='center'>Jon's Cell Phone Message Form</h3>


<form method='post' action='cellphone.cgi'>
<center>
<table border='1'>
<tr>
  <td colspan='2'>Send VERY short messages to my cell phone:</td>
</tr>
<tr>
  <td><b>Subject</b></td>
  <td><input type='text' name='subject'></td>
</tr>
<tr>
  <td><b>Message</b></td>
  <td><textarea name='body' cols='20' rows='8'></textarea></td>
</tr>

<tr>
  <td colspan='2' align='center'><input type='submit' name='donext' value='Send It'></td>
</tr>
</table>
</center>
</form>
</body>
</html>

