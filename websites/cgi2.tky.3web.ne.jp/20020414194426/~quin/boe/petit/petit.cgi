<font size=2>名前：</font><input type=text name=name size=8 value="" class="tex"><br>
<font size=2>色：</font><select name=color class="tex">
<option value="800000" selected>茶色
<option value="DF0000">赤色
<option value="ff1493">深桃色
<option value="008040">緑色
<option value="0000FF">青色
