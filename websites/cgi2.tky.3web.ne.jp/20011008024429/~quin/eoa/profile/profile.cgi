function SubmitCheck(){
	if(document.inpass.name.value==""){
		if(document.inpass.pass.value==""){
			alert("名前とpasswordを入力してください。");
			return false;
		}
		alert("名前を入力してください。");
		return false;
	} else {
		if(document.inpass.pass.value==""){
			alert("passwordを入力してください。");
			return false;
		}
		return true;
	}
}
