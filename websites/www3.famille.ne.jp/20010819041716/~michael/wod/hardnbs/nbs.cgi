<option value="m11.gif">男性11
<option value="m12.gif">男性12
<option value="m13.gif">男性13
<option value="m14.gif">男性14
<option value="m15.gif">男性15
<option value="f01.gif">女性01
<option value="f02.gif">女性02
<option value="f03.gif">女性03
<option value="f04.gif">女性04
<option value="f05.gif">女性05
</select>
　<a href="./nbs.cgi?mode=list"><img src="img/list.gif" width="32" height="9" border="0"></a></td>
</tr>
<tr>
<td nowrap><b>文字の色</b></td>
<td nowrap>
<input type="radio" name="color" value="#0000FF" checked><font size="+1" color="#0000FF">▼</font>
<input type="radio" name="color" value="#FF3333"><font size="+1" color="#FF3333">▼</font>
<input type="radio" name="color" value="#336633"><font size="+1" color="#336633">▼</font>
<input type="radio" name="color" value="#660066"><font size="+1" color="#660066">▼</font>
