<input type="radio" name="color" value="#FF6633"><font size="+1" color="#FF6633">▼</font>
</tr>
<tr>
<td colspan="2">
<div align="right">
<input type="hidden" name="page" value=""><input type="checkbox" name="cookie" value="ok" checked>登録情報を保存する</div>
</td>
</tr>
