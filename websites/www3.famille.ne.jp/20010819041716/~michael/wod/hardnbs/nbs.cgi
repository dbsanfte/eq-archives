<td><input type="text" name="url" value=""></td>
</tr>
<tr>
<td nowrap><b>MAIL</b></td>
<td><input type="text" name="email" value=""></td>
</tr>
<tr>
<td nowrap><b>コメント</b></td>
<td><textarea name="com" cols="40" rows="5"></textarea></td>
</tr>
<tr>
<td nowrap><b>アイコン</b></td>
