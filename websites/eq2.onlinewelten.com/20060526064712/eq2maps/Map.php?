function koordi(Ereignis)
{
    if (document.all) 
    {
        //Internet Explorer
    	ImgX = window.event.offsetX;
    	ImgY = window.event.offsetY;
    }
    else
    {
	 var AbsX = Ereignis.pageX;
	 var AbsY = Ereignis.pageY;
	 ImgX = AbsX - document.images['karte'].x;
         ImgY = AbsY - document.images['karte'].y;
    }
    ShowLoc();
}
function ShowLoc() 
{
    if(MappingInUse==1)
       return;
       
