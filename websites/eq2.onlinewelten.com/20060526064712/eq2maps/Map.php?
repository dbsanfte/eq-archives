function HLLoc(x,y, vMouseDown, vMouseOver, force) 
{
  
  x = Math.round(x/10000*img_w);
  y = Math.round(y/10000*img_h);
   
  
  if(force==1 && LastSpotLocX!=-1 && (x!=LastSpotLocX || y!=LastSpotLocY))
     return;
  var i;
  
  
  //Replace funktioniert nicht richtig, wenn man nur einaml drüber läuft
  for(i=0;i<5;i++)
  {
	  vMouseDown = vMouseDown.replace(/%hk%/,"'");
	  vMouseDown = vMouseDown.replace(/%dhk%/,"'");
	  vMouseOver = vMouseOver.replace(/%hk%/,"'");
	
	  vMouseDown = vMouseDown.replace(/%auf%/,"(");
	  vMouseOver = vMouseOver.replace(/%auf%/,"(");
	
	  vMouseDown = vMouseDown.replace(/%zu%/,")");
	  vMouseOver = vMouseOver.replace(/%zu%/,")");
	  vMouseOver = vMouseOver.replace(/&lt;br&gt;/,"<br>");
  }
  HLLocOver = vMouseOver;
  HLLocDown = vMouseDown;

  if(x==LastSpotLocX && y==LastSpotLocY)
  {
      if (document.all)
      {
      	 if(force==0)
      	 {
      	    if(document.all.HLSpot.style.visibility == "visible")
      	       document.all.HLSpot.style.visibility = "hidden";
      	    else
      	       document.all.HLSpot.style.visibility = "visible";
      	 }
      	 else
      	       document.all.HLSpot.style.visibility = "visible";
      }
      else
      {
      	 if(force==0)
      	 {
	      	 if(document.images['HLSpot'].style.visibility == "visible")
	            document.images['HLSpot'].style.visibility = "hidden";
	         else
	            document.images['HLSpot'].style.visibility = "visible";
      	 }
      	 else
      	       document.images['HLSpot'].style.visibility = "visible";
	            
      }
      if(force==0)
          return;
  }
  var ImgLeft, ImgTop;
  ImgLeft = 0; ImgTop = 0;
  if (document.all)
  {
    var ParentElement = document.all.karte;	
    while (ParentElement.offsetParent)
    {
      ImgTop += ParentElement.offsetTop;
      ImgLeft += ParentElement.offsetLeft;
      ParentElement = ParentElement.offsetParent;
    }
    ImgTop += ParentElement.offsetTop;
    ImgLeft += ParentElement.offsetLeft;
    document.all.HLSpot.style.left = x+ImgLeft-30;
    document.all.HLSpot.style.top = y+ImgTop-30;
    document.all.HLSpot.style.visibility = "visible";
  }
  else
  {
	ImgLeft = document.images['karte'].x;
	ImgTop = document.images['karte'].y;
        document.images['HLSpot'].style.left = x+ImgLeft-30;
        document.images['HLSpot'].style.top = y+ImgTop-30;
        document.images['HLSpot'].style.visibility = "visible";
  }
  LastSpotLocX = x;
  LastSpotLocY = y;
}

