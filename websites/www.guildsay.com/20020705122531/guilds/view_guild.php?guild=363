					</tr>
					<tr>
						<td class="body">
							<br>
														<strong>By:</strong>
							<span class="name"> <a href="http://www.guildsay.com/guilds/view_character.php?id=2602">Buulash Spiderspirit</a> at 11:23 AM PDT - May 22nd, 2002</span>
						</td>
					</tr>
