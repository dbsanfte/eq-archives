						<td class="body">
							<br>
														<strong>By:</strong>
							<span class="name"> <a href="http://www.guildsay.com/guilds/view_character.php?id=1350">Sherea Spiritwolfe</a> at 12:38 PM PDT - May 20th, 2001</span>
						</td>
					</tr>
