		<td class="row1" width="100%" height="28" valign="top"><table width="100%" border="0" cellspacing="0" cellpadding="0">
			<tr>
				<td width="100%"><a href="viewtopic.php?p=40222&amp;sid=1b36e7787e1c773c7ea16a48a39b36ee#40222"><img src="templates/subBlack/images/icon_minipost.gif" width="12" height="9" alt="Post" title="Post" border="0" /></a><span class="postdetails">Posted: Sat Feb 07, 1:52 am<span class="gen">&nbsp;</span>&nbsp; &nbsp;Post subject: Tweena 65 Ranger</span></td>
				<td valign="top" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=40222&amp;sid=1b36e7787e1c773c7ea16a48a39b36ee"><img src="templates/subBlack/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
