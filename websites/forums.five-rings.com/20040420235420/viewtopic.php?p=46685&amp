				<td valign="top" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=45357&amp;sid=f14e2302a6b40f6d9a72449ca1c7e160"><img src="templates/subBlack/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
