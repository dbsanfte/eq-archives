        <td align="center" bgcolor="#800000" width="100%" ><b><font face="Verdana, Arial, Helvetica" size="2" color="#e4e0d0"><a href=topic.asp?cat_id=1&FORUM_ID=4&TOPIC_ID=908&Topic_Title=Daiyle+R%2EI%2EP%2E&Forum_Title=The+Round+Table><img src="icon_topic_prev.gif" height=15 width=15 alt="Previous Topic" border="0" align="absmiddle" hspace="6"></a><b><b><font face="Verdana, Arial, Helvetica" size="2" color="#e4e0d0">&nbsp;Topic&nbsp;</font></b><a href=topic.asp?cat_id=1&FORUM_ID=4&TOPIC_ID=914&Topic_Title=Time+for+a+raid&Forum_Title=The+Round+Table><img src="icon_topic_next.gif" height=15 width=15 alt="Next Topic" border="0" align="absmiddle" hspace="6"></a></font></b></td>

