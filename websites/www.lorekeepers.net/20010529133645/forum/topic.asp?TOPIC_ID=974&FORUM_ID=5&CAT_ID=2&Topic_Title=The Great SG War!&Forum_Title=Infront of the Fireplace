        &nbsp;<a href="post.asp?method=TopicQuote&TOPIC_ID=974&FORUM_ID=5&CAT_ID=2&Forum_Title=Infront+of+the+Fireplace&Topic_Title=The+Great+SG+War%21"><img src="icon_reply_topic.gif" height=15 width=15 alt="Reply with Quote" border="0" align="absmiddle" hspace="6"></a>

