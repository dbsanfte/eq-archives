                        AddTxt="\r[align=center]"+txt+"[/align]";
                        AddText(AddTxt);
                }              
        }
}


function hyperlink() {
        if (helpmode) {
                alert("Hyperlink Tag\nTurns an url into a hyperlink.\nUsage: [url]http://www.anywhere.com[/url]\nUsage: [url=http://www.anywhere.com]link text[/url]");
        } else if (advmode) {
                AddTxt="[url] [/url]";
                AddText(AddTxt);
