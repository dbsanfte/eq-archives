                } 
        }
}


function center() {
        if (helpmode) {
                alert("Centered tag\nCenters the enclosed text.\nUsage: [align=center]This text is centered[/align]");
        } else if (advmode) {
                AddTxt="[align=center] [/align]";
                AddText(AddTxt);
        } else {  
