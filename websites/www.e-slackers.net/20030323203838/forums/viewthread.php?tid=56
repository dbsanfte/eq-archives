                if (txt!=null) {             
                        AddTxt="[size="+size+"]"+txt+"[/size]";
                        AddText(AddTxt);
                }        
        }
}


function chfont(font) {
        if (helpmode){
                alert("Font Tag\nSets the font face for the enclosed text.\nUsage: [font="+font+"]The font of this text is");
