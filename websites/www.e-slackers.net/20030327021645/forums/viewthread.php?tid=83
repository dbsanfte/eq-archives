                        txt=prompt("ERROR!\nThe only possible values for type of list are blank 'A' and '1'.","");               
                }
                if (txt!=null) {
                        if (txt=="") {
                                AddTxt="\r[list]\r\n";
                        } else {
                                AddTxt="\r[list="+txt+"]\r";
                        } 
                        txt="1";
                        while ((txt!="") && (txt!=null)) {
                                txt=prompt("List Item:\nLeave it blank to End the List",""); 
