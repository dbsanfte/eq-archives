body, tr, td { font-size: 10pt;color:#202020;}
small	{font-size:8pt}
U {color:#aa66aa;}
A:link    { text-decoration:none;      font-weight:bold;color:#7070f0;}
A:visited { text-decoration:none;      font-weight:bold;color:#6060d0;}
A:active  { text-decoration:none;      font-weight:bold;color:#ffff00;}
A:hover   {
	text-decoration:underline;
	font-weight:bold;
	color:#ff0000;
	background-color:#dfdfff;
}

A.menu:link	{ text-decoration:none;      font-weight:bold;color:#FFffff;}
A.menu:visited	{ text-decoration:none;      font-weight:bold;color:#ffffff;}
A.menu:active	{ text-decoration:none;      font-weight:bold;color:#FFffff;}
A.menu:hover	{
	text-decoration:none;
	font-weight:bold;
	color:#ff0000;
}

.kinyuu	{
	background-color: #f0f0ff;
	color: #000000;
	border-style:solid;
	border-color:#8080d0;
	border-top-width:1px;
	border-bottom-width:1px;
	border-right-width:1px;
	border-left-width:1px;
}
.button	{
	font-weight:bold;
	color:#5050af;
	background-color: #f0f0ff;
	border-color:#ffffff;
}

.big	{font-size:16pt;color:#4466aa;font-weight:bold}
.update	{font-size: 9pt;color:#ffffb0}
.name	{font-size:11pt;color=#ffffff}
.chara	{font-size:11pt;color=#6666aa}
.memo	{font-size: 9pt;color=#777777}
.mes	{color=#000088}
