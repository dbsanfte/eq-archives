                <td bgcolor="#333333" width="100%" colspan="2" valign="top">
                  <table width="100%" height="100%" border="0" cellspacing="0" cellpadding="0">
                    <tr>
                      <td valign="top">
                      <img src="icon_posticon.gif" width="15" height="15" border="0" alt="" title="" hspace="3" /><font color="#FFFFFF" face="Trebuchet MS, Tahoma, Verdana, Arial, Helvetica" size="1">Posted&nbsp;-&nbsp;09/06/2004&nbsp;:&nbsp; 6:35:14 PM</font>
                      &nbsp;<a href="pop_profile.asp?mode=display&id=3"><img src="icon_profile.gif" width="15" height="15" border="0" alt="Show Profile" title="Show Profile" align="absmiddle" hspace="6" /></a>
                      &nbsp;<a href="JavaScript:openWindow('pop_messengers.asp?mode=AIM&ID=3')"><img src="icon_aim.gif" width="15" height="15" border="0" alt="Send Lunkk an AOL message" title="Send Lunkk an AOL message" align="absmiddle" hspace="6" /></a>
                      &nbsp;<a href="JavaScript:openWindow('pop_messengers.asp?mode=ICQ&ID=3')"><img src="icon_icq.gif" width="15" height="15" border="0" alt="Send Lunkk an ICQ Message" title="Send Lunkk an ICQ Message" align="absmiddle" hspace="6" /></a>
                      &nbsp;<a href="JavaScript:openWindow('pop_messengers.asp?mode=MSN&ID=3')"><img src="icon_msnm.gif" width="15" height="15" border="0" alt="Click to see Lunkk's MSN Messenger address" title="Click to see Lunkk's MSN Messenger address" align="absmiddle" hspace="6" /></a>
                      &nbsp;<a href="post.asp?method=TopicQuote&TOPIC_ID=748&FORUM_ID=4"><img src="icon_reply_topic.gif" width="15" height="15" border="0" alt="Reply with Quote" title="Reply with Quote" align="absmiddle" hspace="6" /></a>
                      <hr noshade size="1"></td>
