<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0//EN" "http://www.w3.org/TR/REC-html40/strict.dtd">
<html>

<head>
<title>Elemental Dragon: Modify a Resource</title>
<link rel=stylesheet href="http://www.elementaldragon.com/links/pages/links.css" type="text/css" title="style sheet">
</head>
<body>

<h1>Elemental Dragon: Modify a Resource</h1>
	
<p><small class="menu">|
	<a class="menulink" href="http://www.elementaldragon.com/links/pages">Home</a> |
	<a class="menulink" href="http://www.elementaldragon.com/links/cgi-bin/add.cgi">Add a Resource</a> |
	<a class="menulink" href="http://www.elementaldragon.com/links/cgi-bin/modify.cgi">Modify a Resource</a> |
	<a class="menulink" href="http://www.elementaldragon.com/links/pages/New">What's New</a> |
	<a class="menulink" href="http://www.elementaldragon.com/links/pages/Cool">What's Cool</a> |
	<a class="menulink" href="http://www.elementaldragon.com/links/pages/Ratings">Top Rated</a> |
	<a class="menulink" href="http://www.elementaldragon.com/links/cgi-bin/subscribe.cgi">Email Updates</a> |	
	<a class="menulink" href="http://www.elementaldragon.com/links/cgi-bin/jump.cgi?ID=random">Random Link</a> |
	<a class="menulink" href="http://www.elementaldragon.com/links/cgi-bin/search.cgi">Search</a> |
</small></p>

	<form action="http://www.elementaldragon.com/links/cgi-bin/modify.cgi" method="POST">
		<p>Please enter the URL of the link you wish to update. Make sure it is identical to the one already in the database:</p>
		<div class="margin"><input name="Current URL" size="30"></div>
		<p>Now enter the new information (all of it, not just the changes) below:</p>
		<div class="margin">
			<table border="0" cellspacing="0" cellpadding="0">
				<tr><td align="right" valign="top">Title:</td>
					<td><input name="Title" value="" size="50"></td></tr>
				<tr><td align="right" valign="top">URL:</td>
					<td><input name="URL" value="" size="50"></td></tr>
				<tr><td align="right" valign="top">Category:</td>
					<td><SELECT NAME="Category"  SIZE=1><OPTION>---<OPTION>Classes<OPTION>Everquest<OPTION>Fiction<OPTION>Forums<OPTION>General<OPTION>News<OPTION>Other<OPTION>RP<OPTION>Trades</SELECT></td></tr>
				<tr><td align="right" valign="top">Description:</td>
					<td><textarea wrap="virtual" name="Description" value="" rows="3" cols="42"></textarea></td></tr>
				<tr><td align="right" valign="top">Contact Name:</td>
					<td><input name="Contact Name" value="" size="40"></td></tr>					           
				<tr><td align="right" valign="top">Contact Email:</td>
					<td><input name="Contact Email" value="" size="40"></td></tr>					           		           
				<tr><td></td><td><input type="SUBMIT" value="Modify Resource"></td></tr>
			</table>
		</div>
		</form>
	
	<form action="http://www.elementaldragon.com/links/cgi-bin/search.cgi" method="GET">
		<h2>Search</h2>
			<div class="margin">
				<table border="0" cellspacing="0" cellpadding="0">
				<tr><td><strong class="search">Looking for something in particular?</strong></td></tr>
				<tr><td><input type="text" size=15 name="query"> <input type=submit value="Search!"></td></tr>
				<tr><td><small class="more"><a href="http://www.elementaldragon.com/links/cgi-bin/search.cgi">More search options</a></small></td></tr>
				</table>
		</div>
	</form>

		<p><small class="update">Pages Updated On: 7-Mar-2001 - 14:42:03<br>
		Links Engine Powered By: <a href="http://www.gossamer-threads.com/">Gossamer Threads Inc.</a></small></p>

</body>
</html>
