	<form action="http://www.elementaldragon.com/data/dbman/db.cgi" method="post" name="form1">
		<input type=hidden name="db" value="default">
		<input type=hidden name="uid" value="">	
	<center>
		<table border=1 bgcolor="#FFFFFF" cellpadding=5 cellspacing=3 width=500 align=center valign=top>
			<tr><td colspan=2 bgcolor="black">
					<FONT FACE="MS Sans Serif, arial,helvetica" size=1 COLOR="#FFFFFF">
                    <b>Elemental Dragon Members Database: Login</b>
			</td></tr>
			<tr><td>
					<p><center><font face="verdana,arial,helvetica" size="4">
					<b>Log On</b></font></center><br>
					<font face="verdana,arial,helvetica" size="2">If you havent Signup for an
Account click <a
href="http://www.elementaldragon.com/data/dbman/db.cgi?signup_form=1">here</a>,
otherwise login in normally.<p>
					<table border=0>
					<tr><td><Font face="Verdana, Arial, Helvetica" Size=2 Color=#003399><b>User ID:</b></FONT></td>
						<td><input type="TEXT" name="userid"></td></tr>
					<tr><td><Font face="Verdana, Arial, Helvetica" Size=2 Color=#003399><b>Password:</b></FONT></td>
						<td><input type="PASSWORD" name="pw"></td></tr>
					</table>		
