<table width="100%" border="0" cellspacing="0" cellpadding="0"><tr><td nowrap><form action="UltraBoard.cgi" name="form" method="post"><input type="hidden" name="SID" value="7221"><input type="hidden" name="action" value="DoSearch"></td></tr></table>
<table border="0" width="100%" align="Center" cellspacing="0" cellpadding="1" class="border">
  <tr>
    <td width="100%">
      <table width="100%" cellspacing="1" cellpadding="4" border="0">

        <tr class="category">
          <td width="100%"><font class="category">Search</font></td>
        </tr>
        <tr class="body">
          <td width="100%">
            <table width="100%" cellspacing="0" cellpadding="2">
              <tr>
                <td width="100%" colspan="3"><font class="body">Fill out as many fields as possible to narrow search results.</font></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="textbox">Keyword</font>&nbsp;</td>
                <td width="60%" valign="top" nowrap><input type="text" name="FORM_KEYWORDS" size="45" maxlength="128" class="textbox"></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-textbox">enter keywords that you want to search for. (sperate words with a space)</font></td></tr></table></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap>&nbsp;</td>
                <td valign="top" width="100%" colspan="2"><table border="0" cellspacing="0" cellpadding="0"><tr><tr><td valign="top"><input type="radio" name="FORM_BOOLEAN" value="ANY" class="radio"></td><td><font class="body">Match any of the words.</font></td></tr><td valign="top"><input type="radio" name="FORM_BOOLEAN" value="ALL" class="radio" checked></td><td><font class="body">Match all the words.</font></td></tr></table></td>
                
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="selectbox">Within</font>&nbsp;</td>
                <td width="60%" valign="top" nowrap><select name="FORM_METHOD" class="selectbox"><option value="SBUN">subject, body, or author fields</option><option value="SB">subject, or body fields</option><option value="SUN">subject, or author fields</option><option value="S">subject field only</option><option value="B">body field only</option><option value="UN">author field only</option></select></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-selectbox">select fields that you want to search in.</font></td></tr></table></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="selectbox">Boards</font>&nbsp;</td>
                <td width="60%" valign="top" nowrap><select name="FORM_BOARDS" size="10" multiple class="selectbox"><option value="*">+ Horizon Tavern</option><option value="6">- Guild Say (Offline mode)</option><option value="19">- Horizon Daily</option><option value="10">- Hunts / Events</option><option value="13">- Epiq Quests</option><option value="16">- Incident Reports</option><option value="*">+ New Members Sign-Up</option><option value="17">- Guild Recruitment</option></select></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-selectbox">select boards that you want to search in.<br>you can use [ctrl] or [control] key to select muliple boards.</font></td></tr></table></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="selectbox">Post Date</font>&nbsp;</td>
                <td valign="top" width="60%" nowrap>
                  <table width="100%" border="0" cellspacing="0" cellpadding="0">
                    <tr>
                      <td nowrap><select name="FORM_POST_DATE_BOOLEAN"><option value="GT">more</option><option value="LT" selected>less</option></select></td>
                      <td nowrap><font class="body">&nbsp;&nbsp;than&nbsp;&nbsp;</font></td>
                      <td width="100%"><select name="FORM_POST_DATE_DAYS" class="selectbox"><option value="*">any days</option><option value="NA">n/a</option><option value="1">1 day</option><option value="2">2 days</option><option value="3">3 days</option><option value="7">7 days</option><option value="14">14 days</option><option value="30" selected>30 days</option><option value="45">45 days</option><option value="60">60 days</option><option value="90">90 days</option><option value="180">180 days</option><option value="365">365 days</option></select></td>
                    </tr>
                  </table>
                </td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-textbox">filter results by post age</font></td></tr></table></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="selectbox">Sort</font>&nbsp;</td>
                <td valign="top" width="60%" nowrap>
                  <table width="100%" border="0" cellspacing="0" cellpadding="0">
                    <tr>
                      <td nowrap><font class="body">Sort&nbsp;&nbsp;</font></td>
                      <td nowrap><select name="FORM_SORT_FIELD"><option value="SUBJECT">subject</option><option value="NICKNAME">author</option><option value="POST_SECOND">post date</option><option value="LAST_POST_SECOND" selected>last post date</option></select></td>
                      <td nowrap><font class="body">&nbsp;&nbsp;by&nbsp;&nbsp;</font></td>
                      <td width="100%"><select name="FORM_SORT_ORDER" class="selectbox"><option value="A-Z">ascending</option><option value="Z-A" selected>descending</option></select></td>
                      <td nowrap><font class="body">&nbsp;&nbsp;order.</font></td>
                    </tr>
                  </table>
                </td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-textbox">select the order of the results.</font></td></tr></table></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="radio">View Mode</font>&nbsp;</td>
                <td valign="top" width="100%" colspan="2"><table border="0" cellspacing="0" cellpadding="0"><tr><tr><td valign="top"><input type="radio" name="FORM_VIEW" value="TopicOnly" class="radio" checked></td><td><font class="body">list topic headlines only.</font></td></tr><td valign="top"><input type="radio" name="FORM_VIEW" value="ALL" class="radio"></td><td><font class="body">list topic headlines and their replies.</font></td></tr></table></td>
                
              </tr>
            </table>
            <table border="0" width="100%" cellspacing="0" cellpadding="2">
              <tr>
                <td width="150" valign="top" nowrap>&nbsp;</td>
                <td width="60%" nowrap><input type="submit" value="Search" class="button"> <input type="reset" value="Cancel" class="button"></td>
                <td width="40%" valign="top" nowrap>&nbsp;</td>
              </tr>

            </table>
          </td>
        </tr>

      </table>
    </td>
