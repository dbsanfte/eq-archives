	<font face="verdana,arial,helvetica" size="1" >Steel Warrior Moderator</font><br>
	<img src="avatar.php?userid=7&dateline=1051095112" border="0" alt=""><p>
<a href="showthread.php?postid=8734#post8734"><font face="verdana,arial,helvetica" size="1" >Post #7</font></a><br>
