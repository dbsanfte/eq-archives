  </tr><tr>
    <td colspan=3 bgcolor="#DEE7EF" class="catbg"><font class="catbg" size=2>Started by <a href="http://www.eq-eod.com/cgi-bin/yabb/YaBB.pl?action=viewprofile;username=Talmarr" alt="View Profile: solei">Talmarr</a> | Last post by <a href="http://www.eq-eod.com/cgi-bin/yabb/YaBB.pl?action=viewprofile;username=solei" alt="View Profile: solei">solei</a></font></td>
