<HTML>
<HEAD>

	<TITLE>Netster&#8482;</TITLE>
</HEAD>
<BODY BGCOLOR=#FFFFFF>
<! Opening ./html\tripplus_form.html >

<style><!--
body,td,a,p,.h{font-family:arial,sans-serif; font-size: 11pt;}
//-->
</style>

<FORM ACTION="/mapqtrip/scripts/mqtripplus.exe" METHOD=GET target="_top">


<! $GEO_OUTPUT hidden>
	<table align="center" cellspacing="2" cellpadding="2" border="0" width="675">
		<tr>
			<td colspan="2" align="center" style="font-size: 14pt; font-weight: bold;">
				Driving Directions
			</td>
		</tr>
		<tr>
			<td colspan="2" align="center">
				<IMG SRC="/mapqtrip/graphics/poweredbymq.gif">
			</td>
		</tr>
		<tr>
		    <td width="50%">
				<TABLE BORDER=0 WIDTH=100%>
					<TR>
						<TD COLSPAN=2 style="font-style: italic; color: 6193CE; font-weight: bold;">
							Select Your Origin:
						</TD>
					</TR>
					<!-- Don't display any of the address fields if the street list is being displayed. -->
						<TR>
							<TD COLSPAN=2 ALIGN=CENTER>
								<FONT COLOR=#cc0000>

								<! $GEO_OUTPUT origin_message>
								</FONT>
							</TD>
						</TR>
						<TR>
							<TD>Address</TD>
							<TD>
<INPUT TYPE=TEXT NAME=ADDR_ORIGIN VALUE="" SIZE=20 MAXLENGTH=30>

								<! $GEO_OUTPUT origin_addr>
							</TD>
						</TR>
						<TR>
							<TD>City</TD>
									<TD>
<INPUT TYPE=TEXT NAME=CITY_ORIGIN VALUE="" SIZE=20 MAXLENGTH=30>

										<! $GEO_OUTPUT origin_city>
									</TD>
								</TR>
								<TR>
									<TD>State</TD>
									<TD>
<INPUT TYPE=TEXT NAME=STATE_ORIGIN VALUE="" SIZE=6 MAXLENGTH=2>

										<! $GEO_OUTPUT origin_state>
									</TD>
								</TR>
						</TR>
						<TR>
							<TD>Zip / Postal Code</TD>
							<TD>
<INPUT TYPE=TEXT NAME=ZO VALUE="" SIZE=10 MAXLENGTH=10>

								<! $GEO_OUTPUT origin_zip>
							</TD>
						</TR>
						<!-- Don't display the country field if the city list is being displayed. -->
			                 	<!-- Don't need a <TD> here because the included file has one.  -->
							<TR>
<! Opening ./html\tripplus_countries_origin.html >





























<TD>Country:</TD>
<TD>
<SELECT name = OCC>
<!-- You must use the ISO Country Code -->
<OPTION VALUE="BE">Belgium</OPTION>
<OPTION VALUE="CA">Canada</OPTION>
<OPTION VALUE="DK">Denmark</OPTION>
<OPTION VALUE="FR">France</OPTION>
<OPTION VALUE="DE">Germany</OPTION>
<OPTION VALUE="UK">Great Britain</OPTION>
<OPTION VALUE="IT">Italy</OPTION>
<OPTION VALUE="LU">Luxembourg</OPTION>
<OPTION VALUE="MX">Mexico</OPTION>
<OPTION VALUE="NL">The Netherlands</OPTION>
<OPTION VALUE="ES">Spain</OPTION>
<OPTION VALUE="SE">Sweden</OPTION>
<OPTION VALUE="CH">Switzerland</OPTION>
<OPTION VALUE="US" Selected>United States</OPTION>
</SELECT>
</TD>


								<! $GEO_READ_HTML tripplus_countries_origin>
							</TR>
				</TABLE>
			</td>
		    <td width="50%">
				<TABLE BORDER=0 WIDTH=100%>
					<TR>
						<TD COLSPAN=2 style="font-style: italic; color: 6193CE; font-weight: bold;">
							Select Your Destination:
						</TD>
					</TR>
					<!-- Don't display any of the the address fields if the street list is being displayed. -->
						<TR>
							<TD COLSPAN=2 ALIGN=CENTER>
								<FONT COLOR=#cc0000>

								<! $GEO_OUTPUT dest_message>
								</FONT>
							</TD>
						</TR>
						<TR>
							<TD>Address</TD>
							<TD>
<INPUT TYPE=TEXT NAME=ADDR_DESTINATION VALUE="" SIZE=20 MAXLENGTH=30> 

								<! $GEO_OUTPUT dest_addr>
							</TD>
						</TR>
						<TR>
							<TD>City</TD>
									<TD>
<INPUT TYPE=TEXT NAME=CITY_DESTINATION VALUE="" SIZE=20 MAXLENGTH=30>

										<! $GEO_OUTPUT dest_city>
									</TD>
								</TR>
								<TR>
									<TD>State</TD>
									<TD>
<INPUT TYPE=TEXT NAME=STATE_DESTINATION VALUE="" SIZE=6 MAXLENGTH=2>

										<! $GEO_OUTPUT dest_state>
									</TD>
								</TR>
						</TR>
						<TR>
							<TD>Zip / Postal Code</TD>
							<TD>
<INPUT TYPE=TEXT NAME=ZD VALUE="" SIZE=10 MAXLENGTH=10>

								<! $GEO_OUTPUT dest_zip>
							</TD>
						</TR>
						<!-- Don't display the country field if the city list is being displayed. -->
			                 	<!-- Don't need a <TD> here because the included file has one.            -->
							<TR>
<! Opening ./html\tripplus_countries_dest.html >





























<TD>Country:</TD>
<TD>
<SELECT name = DCC>
<!-- You must use the ISO Country Code -->
<OPTION VALUE="BE">Belgium</OPTION>
<OPTION VALUE="CA">Canada</OPTION>
<OPTION VALUE="DK">Denmark</OPTION>
<OPTION VALUE="FR">France</OPTION>
<OPTION VALUE="DE">Germany</OPTION>
<OPTION VALUE="UK">Great Britain</OPTION>
<OPTION VALUE="IT">Italy</OPTION>
<OPTION VALUE="LU">Luxembourg</OPTION>
<OPTION VALUE="MX">Mexico</OPTION>
<OPTION VALUE="NL">The Netherlands</OPTION>
<OPTION VALUE="ES">Spain</OPTION>
<OPTION VALUE="SE">Sweden</OPTION>
<OPTION VALUE="CH">Switzerland</OPTION>
<OPTION VALUE="US" Selected>United States</OPTION>
</SELECT>
</TD>


								<! $GEO_READ_HTML tripplus_countries_dest>
							</TR>
				</TABLE>
			</td>
		</tr>
		<tr>
		    <td colspan="2" align="center">
				<TABLE BORDER=0 WIDTH=100%>
					<TR>
						<TD COLSPAN=2 style="font-style: italic; color: 6193CE; font-weight: bold;">
							Select Your Options:
						</TD>
					</TR>
					<TR>
						<TD valign="top">Result Display</TD>
						<TD><INPUT TYPE="RADIO" NAME="results_display_mode" VALUE="text" > Text Only<BR><INPUT TYPE="RADIO" NAME="results_display_mode" VALUE="overview" CHECKED> Overview Map with Text<BR><INPUT TYPE="RADIO" NAME="results_display_mode" VALUE="turns" > Turn-by-Turn Maps with Text</TD>
					</TR>
					<TR>
						<TD valign="top">Route Options</TD>
						<TD>
					 		<INPUT TYPE="CHECKBOX" NAME="avoid_lmtd_access" VALUE="1" > Avoid Major Highways<BR>
							<INPUT TYPE="CHECKBOX"  NAME="avoid_toll_roads" VALUE="1" > Avoid Toll Roads<BR>
							<INPUT TYPE="CHECKBOX"  NAME="avoid_ferry" VALUE="1" > Avoid Ferry Lanes
						</TD>
					</TR>
					<TR>
						<TD valign="top">Detail Level</TD>
							<TD><INPUT TYPE=RADIO NAME="DetailedNarr" VALUE=1>Detailed Directions<BR><INPUT TYPE=RADIO NAME="DetailedNarr" VALUE=0 CHECKED>Summarized Directions</TD>
					</TR>
				</TABLE>
			</td>
		</tr>
		<tr>
			<td colspan="2" align="center">
				<input type="submit" value="Get Directions" style="font-size: 10pt; font-weight: bold;">
			</td>
		</tr>
	</table>
</FORM>
  <! $GEO_READ_HTML tripplus_form>
</BODY>
</HTML>
<!-- End tripplus.html -->



