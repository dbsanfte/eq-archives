<script>
var bImgBase = "http://eqhalcyons.guildwizard.com/pics/2423/profile/";
var bImgs = document.getElementsByTagName("img");

for(i=0;i<bImgs.length;i++){
	if(bImgs[i].src.match(/\/boardimages\/buttons\/email_sm\.gif/i)){
		bImgs[i].src = bImgBase + "email_sm.gif";
	}
	if(bImgs[i].src.match(/\/whitepages\/online\?icq=/i)){
		bImgs[i].src = bImgBase + "icq.gif";
	}
	if(bImgs[i].src.match(/yahoo.com\/online\?u=/i)){
		bImgs[i].src = bImgBase + "yim2.gif";
	}
}

