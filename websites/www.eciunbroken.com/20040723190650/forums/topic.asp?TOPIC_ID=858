                      &nbsp;<a href="pop_profile.asp?mode=display&id=167"><img src="http://www.eciunbroken.com/forums/images/icon_profile.gif" width="15" height="15" border="0" alt="Show Profile" title="Show Profile" align="absmiddle" hspace="6" /></a>
                      &nbsp;<a href="post.asp?method=ReplyQuote&REPLY_ID=2877&TOPIC_ID=858&FORUM_ID=2"><img src="http://www.eciunbroken.com/forums/images/icon_reply_topic.gif" width="15" height="15" border="0" alt="Reply with Quote" title="Reply with Quote" align="absmiddle" hspace="6" /></a>
