   var fp_i;
   function fp_start () { fp_i = 0; if (! document.fp.q.value.length) fp_adv() }
   function fp_stop () { fp_i = -1; document.fp.q.value = '' }
   function fp_pause () { fp_i = -1 }
   function fp_cl_start () { document.fp.q.value = ''; fp_start() }
   function fp_adv () {
     if (fp_i < 0 || fp_i >= fp_s.length - 1) return;
     var c = fp_s.charAt(fp_i++);
     if (c == '\n') {
       setTimeout('document.fp.q.value = "";fp_adv()',2000);
       return;
     }
     document.fp.q.value += c;
     setTimeout('fp_adv()',160);
   }
