<table border="0" cellspacing="0" cellpadding="0"><tr><td nowrap><form action="UltraBoard.cgi" name="form" method="post"><input type="hidden" name="action" value="DoRegister"></td></tr></table>
<table border="0" width="100%" align="Center" cellspacing="0" cellpadding="1" class="border">
  <tr>
    <td>
      <table width="100%" cellspacing="1" cellpadding="4" border="0">

        <tr class="category">
          <td><font class="category">Registration</font></td>
        </tr>
        <tr class="body">
          <td>
            <table width="100%" cellspacing="0" cellpadding="2">
              <tr>
                <td colspan="3"><font class="body">Please fill out all required (<font class="required">*</font>) fields.</font></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="textbox">Username</font>&nbsp;<font class="required">*</font></td>
                <td width="60%" valign="top" nowrap><input type="text" name="FORM_USERNAME" size="45" maxlength="16" class="textbox"></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-textbox">enter an username for your member account.</font></td></tr></table></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="passwordbox">Password</font>&nbsp;<font class="required">*</font></td>
                <td width="60%" valign="top" nowrap><input type="password" name="FORM_PASSWORD" size="45" maxlength="16" class="passwordbox"></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-passwordbox">enter a password for your member account.</font></td></tr></table></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="passwordbox">Confirm Password</font>&nbsp;<font class="required">*</font></td>
                <td width="60%" valign="top" nowrap><input type="password" name="FORM_CONFIRM_PASSWORD" size="45" maxlength="16" class="passwordbox"></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-passwordbox">please re-enter your previous password for confirmation.</font></td></tr></table></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="radio">Member Group</font>&nbsp;<font class="required">*</font></td>
                <td width="60%" valign="top" nowrap><table border="0" cellspacing="0" cellpadding="0"><tr><td valign="top"><input type="radio" name="FORM_MEMBER_GROUP" value="1" class="radio" checked></td><td><font class="body"><font class="body"><b>Guests of the Guild</b></font><br><font class="sub-body">Guests of the Guild can be added to this group to receive access to selected boards!</font></font></td></tr></table></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-radio">choose a member group to join.</font></td></tr></table></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="textbox">Nickname</font>&nbsp;<font class="required">*</font></td>
                <td width="60%" valign="top" nowrap><input type="text" name="FORM_NICKNAME" size="45" maxlength="32" class="textbox"></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-textbox">enter a nickname that you want other members to see. (you can change it any time)</font></td></tr></table></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="textbox">Email</font>&nbsp;<font class="required">*</font></td>
                <td width="60%" valign="top" nowrap><input type="text" name="FORM_EMAIL" size="45" maxlength="64" class="textbox"></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-textbox">enter your real email address, so you can receive the login information from us.</font></td></tr></table></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap>&nbsp;</td>
                <td valign="top" width="100%" colspan="2"><table border="0" cellspacing="0" cellpadding="0"><tr><td><input type="checkbox" name="FORM_HIDE_EMAIL" value="1" class="checkbox"></td><td width="100%"><font class="body">Hide your email address?</font></td></tr></table></td>
                
              </tr>
              <tr>
                <td colspan="3"><font class="body">&nbsp;</font></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="textbox">Age</font>&nbsp;</td>
                <td width="60%" valign="top" nowrap><input type="text" name="FORM_AGE" size="45" maxlength="2" class="textbox"></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-textbox">how old are you?.</font></td></tr></table></td>
              </tr>
              <tr>
                <td colspan="3"><font class="body">&nbsp;</font></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="textbox">Homepage</font>&nbsp;</td>
                <td width="60%" valign="top" nowrap><input type="text" name="FORM_HOMEPAGE" size="45" maxlength="256" class="textbox"></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-textbox">your homepage address.</font></td></tr></table></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="textbox">Location</font>&nbsp;</td>
                <td width="60%" valign="top" nowrap><input type="text" name="FORM_LOCATION" size="45" maxlength="256" class="textbox"></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-textbox">your home address. city, state, and country...</font></td></tr></table></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="textbox">Occupation</font>&nbsp;</td>
                <td width="60%" valign="top" nowrap><input type="text" name="FORM_OCCUPATION" size="45" maxlength="256" class="textbox"></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-textbox">your occupation.</font></td></tr></table></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="textbox">Interests</font>&nbsp;</td>
                <td width="60%" valign="top" nowrap><input type="text" name="FORM_INTEREST" size="45" maxlength="256" class="textbox"></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-textbox">what interests do you have?</font></td></tr></table></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="textbox">ICQ Number</font>&nbsp;</td>
                <td width="60%" valign="top" nowrap><input type="text" name="FORM_ICQ" size="45" maxlength="16" class="textbox"></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-textbox">your icq number.</font></td></tr></table></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="textarea">Comments</font>&nbsp;</td>
                <td width="60%" valign="top" nowrap><textarea name="FORM_COMMENTS" cols="45" rows="3" wrap="soft" class="textarea"></textarea></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-textarea">any comments for people?</font></td></tr></table></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="textarea">Signature</font>&nbsp;</td>
                <td width="60%" valign="top" nowrap><textarea name="FORM_SIGNATURE" cols="45" rows="3" wrap="soft" class="textarea"></textarea></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-textarea">your signature for your messages.</font></td></tr></table></td>
              </tr>
            </table>
            <table border="0" width="100%" cellspacing="0" cellpadding="2">
              <tr>
                <td width="150" valign="top" nowrap>&nbsp;</td>
                <td width="60%" nowrap><input type="submit" value="Register" class="button"> <input type="reset" value="Cancel" class="button"></td>
                <td width="40%" valign="top" nowrap>&nbsp;</td>
              </tr>

            </table>
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>

