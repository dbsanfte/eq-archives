		<table cellspacing =1 bgcolor =#008000 border=1 cellpadding =8>
		<TR align=center><TD><FONT SIZE="-1" FACE="Arial">Add or remove email address
		<form action="/~park/cgi-bin/mailnews/mail.cgi" method=post>
		<input type=text name="address" size=30><br>
		<input type=radio name=action value=subscribe checked> 
