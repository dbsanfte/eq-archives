		<br><input type="submit" value="Update">
		</form></TD></TR></TABLE>
		
		<BR><BR>
		
		<table cellspacing =1 bgcolor =#008000 border=1 cellpadding =8>
		<TR align=center><TD><FONT SIZE="-1" FACE="Arial">Admin Features
		<form action="/~park/cgi-bin/mailnews/mail.cgi" method=post>
		Send out an email to <B>261</B> emails in database<br><BR>
		<INPUT TYPE="SUBMIT" NAME="sendemail" VALUE="Send Email">
		<BR><BR>
		Delete selected addresses from database<BR>
		<INPUT TYPE="SUBMIT" NAME="delete_select" VALUE="Delete Selected">
		<BR><BR>
		Enter admin password<BR><i>Needed for both of above</I>
		<BR>
		<input type=password name="password" size=20>
		</form></TD></TR></TABLE>

