<table border=0 cellpadding=2><tr>
<td rowspan=2 width=40><br></td><td valign=top nowrap><font color="#006400"><b>Re: 自作</b></font>　<b>MoQ</b> - <small>2002/02/02(Sat) 15:43</small> <font color="#006400"><small>No.27</small></font></td><td valign=top nowrap> &nbsp;  </td><td valign=top>
