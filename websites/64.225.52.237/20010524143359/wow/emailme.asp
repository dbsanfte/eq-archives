<html>
<head>
<title>Send Email to </title>
<meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1">
</head>

<body background="images/CartBackground2.JPG">
<form method="post" action="emailmenow.asp">
  <table width="300" border="0" cellspacing="0" cellpadding="0">
    <tr> 
      <td><B>Email message to </B></td>
    </tr>
    <tr> 
      <td>&nbsp; </td>
    </tr>
    <tr> 
      <td><b>From: </b> 
        <input type="text" name="From" size="30">
      </td>
    </tr>
    <tr> 
      <td><b>E-Mail:</b> 
        <input type="text" name="fromemail">
      </td>
    </tr>
    <tr> 
      <td><b>Message:</b> </td>
    </tr>
    <tr> 
      <td> 
        <textarea name="Messagebody" rows="5" cols="40"></textarea>
      </td>
    </tr>
    <tr> 
      <td>&nbsp;</td>
    </tr>
    <tr> 
      <td> 
        <input type="submit" name="Submit" value="Submit">
        <input type="reset" name="Submit2" value="Reset">
      </td>
    </tr>
    <tr>
      <td><a href="Javascript:history.back(1)"><b>&lt;&lt;Back</b></a></td>
    </tr>
  </table>
</form>
</body>
</html>
