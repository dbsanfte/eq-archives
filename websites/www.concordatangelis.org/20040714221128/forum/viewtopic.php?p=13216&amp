				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=13213&amp;sid=da689d9e786de5221f3f25c0e5a009e0"><img src="templates/Chronicles/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
