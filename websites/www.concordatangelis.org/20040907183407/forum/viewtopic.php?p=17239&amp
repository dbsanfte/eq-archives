				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=17239&amp;sid=c326dd8f3b5cb0a93a3b5b6a0f173fc3"><img src="templates/Chronicles/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
			</tr>
