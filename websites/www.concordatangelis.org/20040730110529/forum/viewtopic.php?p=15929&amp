				<td width="100%"><a href="viewtopic.php?p=15915&amp;sid=710b63825cb5ce14f0ec20f321fb6abd#15915"><img src="templates/Chronicles/images/icon_minipost.gif" width="12" height="9" alt="Post" title="Post" border="0" /></a><span class="postdetails">Posted: Wed Sep 04, 2002 6:25 pm<span class="gen">&nbsp;</span>&nbsp; &nbsp;Post subject: </span></td>
				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=15915&amp;sid=710b63825cb5ce14f0ec20f321fb6abd"><img src="templates/Chronicles/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
			</tr>
