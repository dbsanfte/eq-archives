				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=16019&amp;sid=fd9907a37ca4d4b723af5b1ac0135a72"><img src="templates/Chronicles/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
