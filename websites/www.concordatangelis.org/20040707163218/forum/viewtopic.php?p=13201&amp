			<tr>
				<td width="100%"><a href="viewtopic.php?p=13196&amp;sid=d383954843ed756b992310341f4a1ee2#13196"><img src="templates/Chronicles/images/icon_minipost.gif" width="12" height="9" alt="Post" title="Post" border="0" /></a><span class="postdetails">Posted: Tue Jan 22, 2002 5:27 am<span class="gen">&nbsp;</span>&nbsp; &nbsp;Post subject: </span></td>
				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=13196&amp;sid=d383954843ed756b992310341f4a1ee2"><img src="templates/Chronicles/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
