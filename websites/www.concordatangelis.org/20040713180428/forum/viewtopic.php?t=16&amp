				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=16007&amp;sid=2372f2317deeec3613705eea172117d5"><img src="templates/Chronicles/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
