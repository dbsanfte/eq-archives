				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=15888&amp;sid=3ec44e9b483f47e22a412dc9eb10dc54"><img src="templates/Chronicles/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
