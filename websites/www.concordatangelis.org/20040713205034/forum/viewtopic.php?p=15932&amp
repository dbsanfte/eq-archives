		<td class="row1" width="100%" height="28" valign="top"><table width="100%" border="0" cellspacing="0" cellpadding="0">
			<tr>
				<td width="100%"><a href="viewtopic.php?p=15928&amp;sid=5cce3abb7a0c72e9100ea8178f696f01#15928"><img src="templates/Chronicles/images/icon_minipost.gif" width="12" height="9" alt="Post" title="Post" border="0" /></a><span class="postdetails">Posted: Thu Sep 12, 2002 9:01 am<span class="gen">&nbsp;</span>&nbsp; &nbsp;Post subject: </span></td>
