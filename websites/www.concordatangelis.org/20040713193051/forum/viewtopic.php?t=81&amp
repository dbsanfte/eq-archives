				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=9178&amp;sid=8d6c0a228fcdcb196236f9adf71e85c3"><img src="templates/Chronicles/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
