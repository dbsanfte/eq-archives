			<tr>
				<td width="100%"><a href="viewtopic.php?p=9128&amp;sid=8d6c0a228fcdcb196236f9adf71e85c3#9128"><img src="templates/Chronicles/images/icon_minipost.gif" width="12" height="9" alt="Post" title="Post" border="0" /></a><span class="postdetails">Posted: Tue Jul 02, 2002 10:07 am<span class="gen">&nbsp;</span>&nbsp; &nbsp;Post subject: </span></td>
				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=9128&amp;sid=8d6c0a228fcdcb196236f9adf71e85c3"><img src="templates/Chronicles/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
