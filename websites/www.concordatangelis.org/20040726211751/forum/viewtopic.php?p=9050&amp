				<td width="100%"><a href="viewtopic.php?p=9048&amp;sid=fc96734d6d01a3d90098a113f51bcc69#9048"><img src="templates/Chronicles/images/icon_minipost.gif" width="12" height="9" alt="Post" title="Post" border="0" /></a><span class="postdetails">Posted: Sun Dec 02, 2001 7:38 am<span class="gen">&nbsp;</span>&nbsp; &nbsp;Post subject: </span></td>
				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=9048&amp;sid=fc96734d6d01a3d90098a113f51bcc69"><img src="templates/Chronicles/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
