			<tr>
				<td width="100%"><a href="viewtopic.php?p=17030&amp;sid=d38238639cbf55bd6cf3c1beae19c644#17030"><img src="templates/Chronicles/images/icon_minipost.gif" width="12" height="9" alt="Post" title="Post" border="0" /></a><span class="postdetails">Posted: Wed Oct 01, 2003 3:14 pm<span class="gen">&nbsp;</span>&nbsp; &nbsp;Post subject: Arriik Nobleblade's Demense</span></td>
				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=17030&amp;sid=d38238639cbf55bd6cf3c1beae19c644"><img src="templates/Chronicles/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
