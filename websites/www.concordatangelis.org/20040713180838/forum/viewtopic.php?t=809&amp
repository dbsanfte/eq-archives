				<td width="100%"><a href="viewtopic.php?p=17044&amp;sid=d38238639cbf55bd6cf3c1beae19c644#17044"><img src="templates/Chronicles/images/icon_minipost.gif" width="12" height="9" alt="Post" title="Post" border="0" /></a><span class="postdetails">Posted: Mon Oct 06, 2003 7:40 pm<span class="gen">&nbsp;</span>&nbsp; &nbsp;Post subject: </span></td>
