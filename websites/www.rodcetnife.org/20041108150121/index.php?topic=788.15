							<table width="100%" border="0"><tr>
								<td align="left" valign="middle"><a href="http://www.rodcetnife.org/index.php?topic=788.msg7299#msg7299"><img src="http://www.rodcetnife.org/Themes/classic/images/post/xx.gif" alt="" border="0" /></a></td>
								<td align="left" valign="middle">
									<b><a href="http://www.rodcetnife.org/index.php?topic=788.msg7299#msg7299">Re:Laterz</a></b><br />
									<span class="smalltext">&#171; <b>Reply #26 on:</b> April 26, 2004, 04:05:15 pm &#187;</span></td>
								<td align="right" valign="bottom" height="20" nowrap="nowrap" style="font-size: smaller;">
