						<td valign="top" width="15%" rowspan="2">
							<b><a href="http://www.rodcetnife.org/index.php?action=profile;u=1006" title="View the profile of Calidiel">Calidiel</a></b><br />
							<span class="smalltext">
								Orc Pawn<br />
