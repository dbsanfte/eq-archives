								<a href="http://www.rodcetnife.org/index.php?action=profile;u=467"><img src="http://www.rodcetnife.org/Themes/classic/images/icons/profile_sm.gif" alt="View Profile" title="View Profile" border="0" /></a>
								<a href="mailto:gary_dennis@hotmail.com"><img src="http://www.rodcetnife.org/Themes/classic/images/email_sm.gif" alt="Email" title="Email" border="0" /></a>
							</span>
						</td>
