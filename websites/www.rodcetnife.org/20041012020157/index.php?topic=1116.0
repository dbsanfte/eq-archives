			<tr><td class="windowbg2">
				<table width="100%" cellpadding="5" cellspacing="0">
					<tr>
						<td valign="top" width="15%" rowspan="2">
							<b><a href="http://www.rodcetnife.org/index.php?action=profile;u=394" title="View the profile of Tavaran">Tavaran</a></b><br />
							<span class="smalltext">
								Orc Pawn<br />
