							<table width="100%" border="0"><tr>
								<td align="left" valign="middle"><a href="http://www.rodcetnife.org/index.php?topic=254.msg1123#msg1123"><img src="http://www.rodcetnife.org/Themes/classic/images/post/xx.gif" alt="" border="0" /></a></td>
								<td align="left" valign="middle">
									<b><a href="http://www.rodcetnife.org/index.php?topic=254.msg1123#msg1123">Re:Loyalist Shield of Honor</a></b><br />
									<span class="smalltext">&#171; <b>Reply #3 on:</b> June 12, 2003, 10:22:50 am &#187;</span></td>
