	<tr>
		<td align="left" class="catbg" width="100%" height="35">
			<table cellpadding="3" cellspacing="0" width="100%">
				<tr>
					<td>
						<b>Pages:</b> [<b>1</b>] <a class="navPages" href="http://www.rodcetnife.org/index.php?topic=813.15">2</a> <a class="navPages" href="http://www.rodcetnife.org/index.php?topic=813.30">3</a> <b> ... </b><a class="navPages" href="http://www.rodcetnife.org/index.php?topic=813.285">20</a> 
					</td>
					<td align="right" style="font-size: smaller;"><a href="http://www.rodcetnife.org/index.php?action=printpage;topic=813.0" target="_blank"><img src="http://www.rodcetnife.org/Themes/classic/images/english/print.gif" alt="Print" border="0" /></a></td>
