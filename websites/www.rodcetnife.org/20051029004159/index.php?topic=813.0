<table width="100%" cellpadding="3" cellspacing="0">
	<tr>
		<td valign="bottom"><span class="nav"><img src="http://www.rodcetnife.org/Themes/classic/images/icons/folder_open.gif" alt="+" border="0" />&nbsp; <b><a href="http://www.rodcetnife.org/index.php" class="nav">Rodcetnife.org Forums</a></b><br /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/linktree_side.gif" alt="|-" border="0" /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/folder_open.gif" alt="+" border="0" />&nbsp; <b><a href="http://www.rodcetnife.org/index.php#1" class="nav">General Category</a></b><br /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/linktree_main.gif" alt="| " border="0" /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/linktree_side.gif" alt="|-" border="0" /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/folder_open.gif" alt="+" border="0" />&nbsp; <b><a href="http://www.rodcetnife.org/index.php?board=1.0" class="nav">General Discussion</a></b> (Moderators: <a href="http://www.rodcetnife.org/index.php?action=profile;u=1" title="Board Moderator">Kinladar</a>, <a href="http://www.rodcetnife.org/index.php?action=profile;u=15" title="Board Moderator">Killy</a>, <a href="http://www.rodcetnife.org/index.php?action=profile;u=49" title="Board Moderator">Kweil</a>)<br /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/linktree_main.gif" alt="| " border="0" /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/linktree_main.gif" alt="| " border="0" /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/linktree_side.gif" alt="|-" border="0" /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/folder_open.gif" alt="+" border="0" />&nbsp; <b><a href="http://www.rodcetnife.org/index.php?topic=813.0" class="nav">History of Rodcet Nife  [read and add to it]</a></b></span></td>
		<td align="center" class="smalltext">0 Members and 1 Guest are viewing this topic.</td>
		<td valign="bottom" align="right" class="smalltext">
			<span class="nav"><a href="http://www.rodcetnife.org/index.php?topic=813.0;prev_next=prev">&laquo; previous</a> <a href="http://www.rodcetnife.org/index.php?topic=813;prev_next=next">next &raquo;</a></span>
		</td>
