								</td>
							</tr></table>
							<hr width="100%" size="1" class="hrcolor" />Castamist - 65 Archon - RN
						</td>
					</tr>
				</table>
			</td></tr>
		</table>
	</td></tr>
	<tr><td style="padding: 1px 1px 0 1px;">
