									<img src="http://www.rodcetnife.org/Themes/classic/images/ip.gif" alt="" border="0" /> Logged
								</td>
							</tr></table>
							<hr width="100%" size="1" class="hrcolor" /><a href="http://www.magelo.com/eq_view_profile.html?num=726998" target="_blank">Infiltrator Corboy Chillin</a><br /><a href="http://www.magelo.com/eq_view_profile.html?num=322842" target="_blank">Vicar Mamael Chillin</a><br />&quot;Last Chillin Standing.&quot;
						</td>
					</tr>
				</table>
			</td></tr>
		</table>
	</td></tr>
	<tr><td style="padding: 1px 1px 0 1px;">
		<a name="msg13960"></a>
		<table cellpadding="3" cellspacing="0" border="0" width="100%">
			<tr><td class="windowbg">
