					<tr>
						<td valign="top" width="15%" rowspan="2">
							<b><a href="http://www.rodcetnife.org/index.php?action=profile;u=1094" title="View the profile of Eternalruby">Eternalruby</a></b><br />
							<span class="smalltext">
								Orc Pawn<br />
								<img src="http://www.rodcetnife.org/Themes/classic/images/star.gif" alt="*" border="0" /><br />
