								<a href="mailto:eternalruby@yahoo.com"><img src="http://www.rodcetnife.org/Themes/classic/images/email_sm.gif" alt="Email" title="Email" border="0" /></a>
							</span>
						</td>
						<td valign="top" width="85%" height="100%">
