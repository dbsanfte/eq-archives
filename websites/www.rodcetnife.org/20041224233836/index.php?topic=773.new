						<td valign="top" width="15%" rowspan="2">
							<b><a href="http://www.rodcetnife.org/index.php?action=profile;u=167" title="View the profile of Wyztyz">Wyztyz</a></b><br />
							<span class="smalltext">
								Guild Leader<br />
