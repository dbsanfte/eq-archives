<table width="100%" cellpadding="3" cellspacing="0">
	<tr>
		<td valign="bottom"><span class="nav"><img src="http://www.rodcetnife.org/Themes/classic/images/icons/folder_open.gif" alt="+" border="0" />&nbsp; <b><a href="http://www.rodcetnife.org/index.php" class="nav">Rodcetnife.org Forums</a></b><br /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/linktree_side.gif" alt="|-" border="0" /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/folder_open.gif" alt="+" border="0" />&nbsp; <b><a href="http://www.rodcetnife.org/index.php#1" class="nav">General Category</a></b><br /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/linktree_main.gif" alt="| " border="0" /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/linktree_side.gif" alt="|-" border="0" /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/folder_open.gif" alt="+" border="0" />&nbsp; <b><a href="http://www.rodcetnife.org/index.php?board=6.0" class="nav">Blacklist</a></b> (Moderators: <a href="http://www.rodcetnife.org/index.php?action=profile;u=1" title="Board Moderator">Kinladar</a>, <a href="http://www.rodcetnife.org/index.php?action=profile;u=15" title="Board Moderator">Killy</a>, <a href="http://www.rodcetnife.org/index.php?action=profile;u=49" title="Board Moderator">Kweil</a>)<br /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/linktree_main.gif" alt="| " border="0" /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/linktree_main.gif" alt="| " border="0" /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/linktree_side.gif" alt="|-" border="0" /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/folder_open.gif" alt="+" border="0" />&nbsp; <b><a href="http://www.rodcetnife.org/index.php?topic=237.0" class="nav">7 from Century of Flame, 1 from Arcana Armicita</a></b></span></td>
		<td align="center" class="smalltext">0 Members and 1 Guest are viewing this topic.</td>
		<td valign="bottom" align="right" class="smalltext">
			<span class="nav"><a href="http://www.rodcetnife.org/index.php?topic=237.0;prev_next=prev">&laquo; previous</a> <a href="http://www.rodcetnife.org/index.php?topic=237;prev_next=next">next &raquo;</a></span>
		</td>
	</tr>
</table>
<table width="100%" cellpadding="3" cellspacing="0" border="0" class="tborder" style="border-bottom: 0;">
	<tr>
		<td align="left" class="catbg" width="100%" height="35">
			<table cellpadding="3" cellspacing="0" width="100%">
				<tr>
					<td>
						<b>Pages:</b> [<b>1</b>] <a class="navPages" href="http://www.rodcetnife.org/index.php?topic=237.15">2</a> <a class="navPages" href="http://www.rodcetnife.org/index.php?topic=237.30">3</a> <a class="navPages" href="http://www.rodcetnife.org/index.php?topic=237.45">4</a> 
					</td>
					<td align="right" style="font-size: smaller;"><a href="http://www.rodcetnife.org/index.php?action=printpage;topic=237.0" target="_blank"><img src="http://www.rodcetnife.org/Themes/classic/images/english/print.gif" alt="Print" border="0" /></a></td>
				</tr>
