						<td valign="top" width="85%" height="100%">
							<table width="100%" border="0"><tr>
								<td align="left" valign="middle"><a href="http://www.rodcetnife.org/index.php?topic=933.msg9276#msg9276"><img src="http://www.rodcetnife.org/Themes/classic/images/post/xx.gif" alt="" border="0" /></a></td>
								<td align="left" valign="middle">
