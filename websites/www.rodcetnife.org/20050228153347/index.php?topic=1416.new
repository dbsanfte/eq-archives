								</td>
								<td align="right" valign="bottom" class="smalltext">
									<img src="http://www.rodcetnife.org/Themes/classic/images/ip.gif" alt="" border="0" /> Logged
								</td>
							</tr></table>
							<hr width="100%" size="1" class="hrcolor" /><img src="http://apoth.dyndns.org/Signatures/Griglon.jpg" alt="" border="0" /><br /><a href="http://www.magelo.com/eq_view_profile.html?num=528937" target="_blank">http://www.magelo.com/eq_view_profile.html?num=528937</a>
						</td>
					</tr>
				</table>
			</td></tr>
		</table>
	</td></tr>
	<tr><td style="padding: 1px 1px 0 1px;">
		<a name="msg14381"></a>
		<table cellpadding="3" cellspacing="0" border="0" width="100%">
			<tr><td class="windowbg">
				<table width="100%" cellpadding="5" cellspacing="0">
