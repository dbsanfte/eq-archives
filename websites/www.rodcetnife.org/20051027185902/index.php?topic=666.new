<table width="100%" cellpadding="3" cellspacing="0">
	<tr>
		<td valign="bottom"><span class="nav"><img src="http://www.rodcetnife.org/Themes/classic/images/icons/folder_open.gif" alt="+" border="0" />&nbsp; <b><a href="http://www.rodcetnife.org/index.php" class="nav">Rodcetnife.org Forums</a></b><br /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/linktree_side.gif" alt="|-" border="0" /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/folder_open.gif" alt="+" border="0" />&nbsp; <b><a href="http://www.rodcetnife.org/index.php#1" class="nav">General Category</a></b><br /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/linktree_main.gif" alt="| " border="0" /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/linktree_side.gif" alt="|-" border="0" /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/folder_open.gif" alt="+" border="0" />&nbsp; <b><a href="http://www.rodcetnife.org/index.php?board=10.0" class="nav">Rants and Raves</a></b><br /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/linktree_main.gif" alt="| " border="0" /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/linktree_main.gif" alt="| " border="0" /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/linktree_side.gif" alt="|-" border="0" /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/folder_open.gif" alt="+" border="0" />&nbsp; <b><a href="http://www.rodcetnife.org/index.php?topic=666.0" class="nav">When a guild loses its identity</a></b></span></td>
