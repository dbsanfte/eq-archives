	<tr>
		<td valign="top" align="right" class="smalltext"> <span class="nav"> <a href="http://www.rodcetnife.org/index.php?topic=320.0;prev_next=prev">&laquo; previous</a> <a href="http://www.rodcetnife.org/index.php?topic=320;prev_next=next">next &raquo;</a></span></td>
