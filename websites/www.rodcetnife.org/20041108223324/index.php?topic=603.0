								<td align="left" valign="middle">
									<b><a href="http://www.rodcetnife.org/index.php?topic=603.msg5045#msg5045">Re:Suggestions</a></b><br />
									<span class="smalltext">&#171; <b>Reply #1 on:</b> January 27, 2004, 03:22:07 pm &#187;</span></td>
								<td align="right" valign="bottom" height="20" nowrap="nowrap" style="font-size: smaller;">
