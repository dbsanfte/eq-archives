								<td nowrap="nowrap"><span style="white-space: nowrap;"><img src="http://www.rodcetnife.org/Themes/classic/images/poll_left.gif" alt="" /><img src="http://www.rodcetnife.org/Themes/classic/images/poll_middle.gif" width="49" height="12" alt="-" /><img src="http://www.rodcetnife.org/Themes/classic/images/poll_right.gif" alt="" /></span>10 (18.5%)</td>
							</tr>
