			window.open("http://www.rodcetnife.org/index.php?action=quotefast;quote=" + messageid + ";sesc=919452151cb69b29e2dd18b16e3dcc89", "quote", "toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,top=40,left=40,width=240,height=90,resizable=no;");
			if (navigator.appName == "Microsoft Internet Explorer")
				window.location.hash = "quickreply";
			else
				window.location.hash = "#quickreply";
		}
	}
// --></script>
