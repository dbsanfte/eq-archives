								<td nowrap="nowrap"><span style="white-space: nowrap;"><img src="http://www.rodcetnife.org/Themes/classic/images/poll_left.gif" alt="" /><img src="http://www.rodcetnife.org/Themes/classic/images/poll_middle.gif" width="41" height="12" alt="-" /><img src="http://www.rodcetnife.org/Themes/classic/images/poll_right.gif" alt="" /></span>7 (15.6%)</td>
							</tr>
