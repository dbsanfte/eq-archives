						</td>
					</tr>
				</table>
			</td></tr>
		</table>
	</td></tr>
	<tr><td style="padding: 1px 1px 0 1px;">
		<a name="msg16766"></a>
		<table cellpadding="3" cellspacing="0" border="0" width="100%">
			<tr><td class="windowbg">
				<table width="100%" cellpadding="5" cellspacing="0">
					<tr>
						<td valign="top" width="15%" rowspan="2">
							<b><a href="http://www.rodcetnife.org/index.php?action=profile;u=1147" title="View the profile of Nartuuk">Nartuuk</a></b><br />
							<span class="smalltext">
								Orc Pawn<br />
								<img src="http://www.rodcetnife.org/Themes/classic/images/star.gif" alt="*" border="0" /><br />
								Posts: 1<br />
								<br />
								<br />
								
								
								
								<br />
								<a href="http://www.rodcetnife.org/index.php?action=profile;u=1147"><img src="http://www.rodcetnife.org/Themes/classic/images/icons/profile_sm.gif" alt="View Profile" title="View Profile" border="0" /></a>
