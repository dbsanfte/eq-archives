<table width="100%" cellpadding="3" cellspacing="0">
	<tr>
		<td valign="bottom"><span class="nav"><img src="http://www.rodcetnife.org/Themes/classic/images/icons/folder_open.gif" alt="+" border="0" />&nbsp; <b><a href="http://www.rodcetnife.org/index.php" class="nav">Rodcetnife.org Forums</a></b><br /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/linktree_side.gif" alt="|-" border="0" /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/folder_open.gif" alt="+" border="0" />&nbsp; <b><a href="http://www.rodcetnife.org/index.php#1" class="nav">General Category</a></b><br /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/linktree_main.gif" alt="| " border="0" /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/linktree_side.gif" alt="|-" border="0" /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/folder_open.gif" alt="+" border="0" />&nbsp; <b><a href="http://www.rodcetnife.org/index.php?board=37.0" class="nav">EQ Artwork and Stories</a></b> (Moderators: <a href="http://www.rodcetnife.org/index.php?action=profile;u=1" title="Board Moderator">Kinladar</a>, <a href="http://www.rodcetnife.org/index.php?action=profile;u=15" title="Board Moderator">Killy</a>, <a href="http://www.rodcetnife.org/index.php?action=profile;u=49" title="Board Moderator">Kweil</a>)<br /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/linktree_main.gif" alt="| " border="0" /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/linktree_main.gif" alt="| " border="0" /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/linktree_side.gif" alt="|-" border="0" /><img src="http://www.rodcetnife.org/Themes/classic/images/icons/folder_open.gif" alt="+" border="0" />&nbsp; <b><a href="http://www.rodcetnife.org/index.php?topic=117.0" class="nav">Chapter 3</a></b></span></td>
