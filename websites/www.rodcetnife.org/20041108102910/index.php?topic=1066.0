	<tr class="windowbg">
		<td width="5%" valign="top"><b>Question:</b></td>
		<td>
			What class would you play in EQ2?
			<table>
				<tr>
					<td style="padding-top: 2ex;">
						<table border="0" cellpadding="0" cellspacing="0">
							<tr>
								<td>Same class</td>
								<td width="7">&nbsp;</td>
								<td nowrap="nowrap"><span style="white-space: nowrap;"><img src="http://www.rodcetnife.org/Themes/classic/images/poll_left.gif" alt="" /><img src="http://www.rodcetnife.org/Themes/classic/images/poll_middle.gif" width="71" height="12" alt="-" /><img src="http://www.rodcetnife.org/Themes/classic/images/poll_right.gif" alt="" /></span>12 (26.7%)</td>
							</tr>
							<tr>
								<td>Very closely related class</td>
								<td width="7">&nbsp;</td>
								<td nowrap="nowrap"><span style="white-space: nowrap;"><img src="http://www.rodcetnife.org/Themes/classic/images/poll_left.gif" alt="" /><img src="http://www.rodcetnife.org/Themes/classic/images/poll_middle.gif" width="41" height="12" alt="-" /><img src="http://www.rodcetnife.org/Themes/classic/images/poll_right.gif" alt="" /></span>7 (15.6%)</td>
							</tr>
							<tr>
								<td>Different class but archetype as now (priest, melee, caster)</td>
								<td width="7">&nbsp;</td>
								<td nowrap="nowrap"><span style="white-space: nowrap;"><img src="http://www.rodcetnife.org/Themes/classic/images/poll_left.gif" alt="" /><img src="http://www.rodcetnife.org/Themes/classic/images/poll_middle.gif" width="11" height="12" alt="-" /><img src="http://www.rodcetnife.org/Themes/classic/images/poll_right.gif" alt="" /></span>2 (4.4%)</td>
							</tr>
							<tr>
								<td>Totally different class</td>
								<td width="7">&nbsp;</td>
								<td nowrap="nowrap"><span style="white-space: nowrap;"><img src="http://www.rodcetnife.org/Themes/classic/images/poll_left.gif" alt="" /><img src="http://www.rodcetnife.org/Themes/classic/images/poll_middle.gif" width="59" height="12" alt="-" /><img src="http://www.rodcetnife.org/Themes/classic/images/poll_right.gif" alt="" /></span>10 (22.2%)</td>
							</tr>
							<tr>
								<td>Not playing EQ2</td>
								<td width="7">&nbsp;</td>
								<td nowrap="nowrap"><span style="white-space: nowrap;"><img src="http://www.rodcetnife.org/Themes/classic/images/poll_left.gif" alt="" /><img src="http://www.rodcetnife.org/Themes/classic/images/poll_middle.gif" width="82" height="12" alt="-" /><img src="http://www.rodcetnife.org/Themes/classic/images/poll_right.gif" alt="" /></span>14 (31.1%)</td>
							</tr>
						</table>
					</td>
					<td valign="bottom" style="padding-left: 15px;">
					</td>
				</tr>
				<tr>
					<td colspan="2"><b>Total Votes: 45</b></td>
				</tr>
			</table><br />
		</td>
