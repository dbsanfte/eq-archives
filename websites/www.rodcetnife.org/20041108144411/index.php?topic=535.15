			window.location.href = "http://www.rodcetnife.org/index.php?action=post;quote=" + messageid + ";topic=535.15;sesc=7c3827f4e5f6f5b8e0e8b7d74686cc36";
		else
		{
			window.open("http://www.rodcetnife.org/index.php?action=quotefast;quote=" + messageid + ";sesc=7c3827f4e5f6f5b8e0e8b7d74686cc36", "quote", "toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,top=40,left=40,width=240,height=90,resizable=no;");
			if (navigator.appName == "Microsoft Internet Explorer")
				window.location.hash = "quickreply";
			else
				window.location.hash = "#quickreply";
		}
	}
// --></script>
