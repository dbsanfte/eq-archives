			window.location.href = "http://www.rodcetnife.org/index.php?action=post;quote=" + messageid + ";topic=1047.30;sesc=2a87928d2f390a5e56e8724e63c98c9e";
		else
		{
			window.open("http://www.rodcetnife.org/index.php?action=quotefast;quote=" + messageid + ";sesc=2a87928d2f390a5e56e8724e63c98c9e", "quote", "toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,top=40,left=40,width=240,height=90,resizable=no;");
			if (navigator.appName == "Microsoft Internet Explorer")
				window.location.hash = "quickreply";
			else
				window.location.hash = "#quickreply";
		}
	}
// --></script>
