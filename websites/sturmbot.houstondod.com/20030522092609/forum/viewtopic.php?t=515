				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=2014&amp;sid=24be228698198b99bae7902a0ae58a08"><img src="templates/TheXiT/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
