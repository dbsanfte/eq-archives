      <script type="text/javascript" language="javascript">
        function jstime(phptime) {
          $newdate = new Date(phptime*1000);
          $hours = $newdate.getHours();
          $mins = $newdate.getMinutes();
          $secs = $newdate.getSeconds();
          $offset = $newdate.getTimezoneOffset()/-0.6;
          if ($hours == 0) {
            $hours = "12";
            $ap = "AM";
          }
          else if ($hours < 12) { 
            $ap = "AM";
          }
          else if ($hours == 12) {
            $ap = "PM";
          }
          else {
            $hours = $hours - 12
            $ap = "PM";
          }
          if ($mins < 10) { $mins = "0"+$mins; }
          if ($secs < 10) { $secs = "0"+$secs; }
          if (Math.abs($offset) < 1000 ) { $timezone = "0"+Math.abs($offset); }
          if ( $offset == 0 ) { $timezone = ""; }
          else if ( $offset < 0 ) { $timezone = "-"+$timezone; }
          else { $timezone = "+"+$timezone; }
          $timezone = "UTC"+$timezone; 
          //$datestring = $newdate.toTimeString();
          $datestring = $hours + ":" + $mins + ":" + $secs + " " + $ap + " " + $timezone;
          document.write($datestring);
        }
      </script>
