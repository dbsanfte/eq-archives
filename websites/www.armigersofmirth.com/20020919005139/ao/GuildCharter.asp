<script language="javascript">
var intPosition=0;
var intSpeed=40;


strMessage = "Armigers of Mirth Charter"
function Type(){
intPosition++;
 if (strMessage.substring(intPosition-1,intPosition) == " ")
 {
  intPosition++
 }
var text = strMessage.substring(0,intPosition);
 if (document.layers)
 {
  document.layers.layerA.document.open();
  document.layers.layerA.document.write("<div style='position:absolute;top:0px;left:0px;font-family:Verdana;font-size:12px;font-weight:bold;color:#F0E68C'>" + text + "</div>");
  document.layers.layerA.document.close();
 }
else if (document.all)
	document.all.layerA.innerHTML=text;
 if (intPosition < strMessage.length)
 {
  timer=setTimeout('Type();',intSpeed);
 }
 
}

function validate(){
var strError = "";

if (strError.length != 0){
	document.parentWindow.window.parent.document.frmHelp.txtHelpScreen.className = "TextHelpError";
	var strTrimMsg = strError.substring(0, strError.length -2);
	showHelpText("Data Error: " + strTrimMsg);
	}
else
    {
	document.frmEditChar.submit();	
    }
}

function showHelpText(strMsg){
	//Don't even try to figure this out - sheer trial and error ;-)
	//This hierarchy should would for any page within an Iframe with the Help Agent in use
	document.parentWindow.window.parent.document.frmHelp.txtHelpScreen.value = strMsg;
	}
function clearHelpText(){
	document.parentWindow.window.parent.document.frmHelp.txtHelpScreen.value = "";
	}
	
function clearit(){
	clearHelpText();
	}

</script>

