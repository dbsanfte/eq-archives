<script LANGUAGE="javascript">

	function validate()
	{
		var strError = "";
		var strErrorHeader = "Unable to submit feedback:" + '\n' + '\n';

		if (document.frmFeedback.txtcontact.checked)
			{
			if (document.frmFeedback.txtEmail.value == "")
			strError = strError + "If you'd like to be contacted, please include an email address." + '\n';
			}

		if (strError.length > 0)
			alert (strErrorHeader + strError);
		else
			document.frmFeedback.submit();
	}
