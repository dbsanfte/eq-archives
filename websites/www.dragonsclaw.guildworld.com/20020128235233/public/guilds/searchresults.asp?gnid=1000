		{
			return false;
		}
	}
	return true;
}
// LTrim
// Inputs: String
// Returns: string with leading spaces removed
function ltrim(strString)
{
	var fldstr, i, newstr, ipos
	fldstr = strString + "";
	newstr = "";
	
	if (fldstr == "") return fldstr;
	
	for	(i = 0;i < fldstr.length; i++)
	{
		if(fldstr.charAt(i)!=" ")
		{
			ipos = (fldstr.length - i)+1;
			newstr = fldstr.substr(i,ipos);
			return newstr;
		}
	}
	return newstr;
}

// Confirm Display
