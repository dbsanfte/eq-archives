}


// Date Validation
// Inputs: Form Element
// Returns: True or False
function okDate(fld)
{
	var fldstr, i
	fldstr = fld.value + "";
	
	if (fldstr == "") return false;
	for	(i = 0;i < fldstr.length; i++)
