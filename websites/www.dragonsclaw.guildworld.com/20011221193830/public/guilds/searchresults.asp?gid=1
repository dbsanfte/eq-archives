// Form Field Validation Function
// Inputs: Form Element
// Returns: True or False
function okCredit(fld)
{
	var fldstr, i
	fldstr = fld.value + "";
	
	if (fld.value == "" || fld.value == null)
	{
		return false;
	}

	if (fld.value.indexOf("-") == "-1" && fld.value.indexOf(" ") == "-1")
