  <font face="Verdana, Arial, Helvetica, sans-serif" size="3"><b><font color="#FFFFCC"><center>Add Your Guild</center></font>
  <table>
  <form action="insert.cfm" method="post">
  <tr><td><font face="Verdana, Arial, Helvetica, sans-serif" size="2"><font color="#CCFFFF"><font color="#FFFFFF">Guild Name:</font></td><td><input type="text" maxlength="50" name="name"></td></tr></td>
  <tr><td><font face="Verdana, Arial, Helvetica, sans-serif" size="2"><font color="#CCFFFF"><font color="#FFFFFF">Password:</font></td><td><input type="password" maxlength="50" name="pass"></td><td><font face="Verdana, Arial, Helvetica, sans-serif" size="2"><font color="#CCFFFF"><font color="#FFFFFF">(Remember your password, you'll need it to edit your guild's data!)</font></td></tr></td><br /> 
  <tr><td><font face="Verdana, Arial, Helvetica, sans-serif" size="2"><font color="#CCFFFF"><font color="#FFFFFF">Website:</font></td><td><input type="text" maxlength="80" name="site"></td><td><font face="Verdana, Arial, Helvetica, sans-serif" size="2"><font color="#CCFFFF"><font color="#FFFFFF">(If you don't have one, simply type N/A! Also, please type the FULL name of your website, I.E. http://www.sitename.com, otherwise the links will not work in the directory!)</font></td></tr></td><br /><br /><br /><br /> 
  <tr><td><font face="Verdana, Arial, Helvetica, sans-serif" size="2"><font color="#CCFFFF"><font color="#FFFFFF">Leader:</font></td><td><input type="text" maxlength="20" name="leader"></td><td></tr></td>
