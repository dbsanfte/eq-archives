			<tr>
				<td width="100%"><a href="viewtopic.php?p=4847&amp;sid=940fc26c45c2808c2ef64f6592eae5cb#4847"><img src="templates/Classic/images/icon_minipost.gif" width="12" height="9" alt="Post" title="Post" border="0" /></a><span class="postdetails">Posted: Thu Jun 03, 2004 11:30 pm<span class="gen">&nbsp;</span>&nbsp; &nbsp;Post subject: </span></td>
				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=4847&amp;sid=940fc26c45c2808c2ef64f6592eae5cb"><img src="templates/Classic/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
