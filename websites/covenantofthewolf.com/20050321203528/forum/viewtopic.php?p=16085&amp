			<tr>
				<td width="100%"><a href="viewtopic.php?p=16086&amp;sid=5c815c244c9761093f5533d5314227e5#16086"><img src="templates/Classic/images/icon_minipost.gif" width="12" height="9" alt="Post" title="Post" border="0" /></a><span class="postdetails">Posted: Fri Sep 24, 2004 12:53 am<span class="gen">&nbsp;</span>&nbsp; &nbsp;Post subject: </span></td>
				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=16086&amp;sid=5c815c244c9761093f5533d5314227e5"><img src="templates/Classic/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
