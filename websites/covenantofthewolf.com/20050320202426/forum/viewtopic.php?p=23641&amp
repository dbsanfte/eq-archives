				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=22129&amp;sid=9dcf8711772a8a09b388f56c951f63dd"><img src="templates/Classic/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
