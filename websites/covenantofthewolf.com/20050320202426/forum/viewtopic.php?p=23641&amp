				<td width="100%"><a href="viewtopic.php?p=21138&amp;sid=9dcf8711772a8a09b388f56c951f63dd#21138"><img src="templates/Classic/images/icon_minipost.gif" width="12" height="9" alt="Post" title="Post" border="0" /></a><span class="postdetails">Posted: Sat Nov 20, 2004 3:55 pm<span class="gen">&nbsp;</span>&nbsp; &nbsp;Post subject: </span></td>
				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=21138&amp;sid=9dcf8711772a8a09b388f56c951f63dd"><img src="templates/Classic/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
