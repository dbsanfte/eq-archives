	<tr>
		<td width="150" align="left" valign="top" class="row2"><span class="name"><a name="22717"></a><b>Kaldarye</b></span><br /><span class="postdetails">Officers<br /><img src="images/avatars/gallery/Avatar_pack_1/568.gif" alt="" border="0" /><br /><br />Joined: 24 Apr 2004<br />Posts: 493<br /></span><br /></td>
		<td class="row2" width="100%" height="28" valign="top"><table width="100%" border="0" cellspacing="0" cellpadding="0">
			<tr>
				<td width="100%"><a href="viewtopic.php?p=22717&amp;sid=9dcf8711772a8a09b388f56c951f63dd#22717"><img src="templates/Classic/images/icon_minipost.gif" width="12" height="9" alt="Post" title="Post" border="0" /></a><span class="postdetails">Posted: Sun Dec 12, 2004 2:13 pm<span class="gen">&nbsp;</span>&nbsp; &nbsp;Post subject: </span></td>
				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=22717&amp;sid=9dcf8711772a8a09b388f56c951f63dd"><img src="templates/Classic/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
			</tr>
