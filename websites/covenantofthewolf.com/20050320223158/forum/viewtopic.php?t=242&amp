				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=764&amp;sid=9df276df29401c732eaa07b1dcc215bb"><img src="templates/Classic/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
