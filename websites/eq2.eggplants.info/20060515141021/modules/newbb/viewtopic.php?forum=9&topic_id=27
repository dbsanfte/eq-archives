          <td class="head"><a id="forumpost91"></a> <a href="http://eq2.eggplants.info/userinfo.php?uid=2">Qadar</a></td>
          <td class="head"><div class="comDate"><span class="comDateCaption">投稿日時: </span> 2006-4-2 13:55</div></td>
