				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=59846&amp;sid=71f38f059beddf46f083876f1d07f8ba"><img src="templates/subSilver/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
