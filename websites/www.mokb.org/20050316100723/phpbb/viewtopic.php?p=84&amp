			<tr>
				<td width="100%"><a href="viewtopic.php?p=84&amp;sid=743a943d11ed29a1f79cea9692c21cce#84"><img src="templates/subSilver/images/icon_minipost.gif" width="12" height="9" alt="Post" title="Post" border="0" /></a><span class="postdetails">Posted: Thu Jan 02, 2003 2:34 pm<span class="gen">&nbsp;</span>&nbsp; &nbsp;Post subject: Want To Join MoKB? -- Updated 10/28/04</span></td>
				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=84&amp;sid=743a943d11ed29a1f79cea9692c21cce"><img src="templates/subSilver/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
