		<td class="row1" width="100%" height="28" valign="top"><table width="100%" border="0" cellspacing="0" cellpadding="0">
			<tr>
				<td width="100%"><a href="viewtopic.php?p=9030&amp;sid=df878149f13a90d7a83789ed2b5fbeab#9030"><img src="templates/Chronicles/images/icon_minipost.gif" width="12" height="9" alt="Post" title="Post" border="0" /></a><span class="postdetails">Posted: Thu Oct 25, 2001 5:59 pm<span class="gen">&nbsp;</span>&nbsp; &nbsp;Post subject: </span></td>
				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=9030&amp;sid=df878149f13a90d7a83789ed2b5fbeab"><img src="templates/Chronicles/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
