				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=9088&amp;sid=3e4b5a2a03e170ff17f00e7370b40c1c"><img src="templates/Chronicles/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
