				<td width="100%"><a href="viewtopic.php?p=9087&amp;sid=3e4b5a2a03e170ff17f00e7370b40c1c#9087"><img src="templates/Chronicles/images/icon_minipost.gif" width="12" height="9" alt="Post" title="Post" border="0" /></a><span class="postdetails">Posted: Tue Feb 19, 2002 8:04 pm<span class="gen">&nbsp;</span>&nbsp; &nbsp;Post subject: </span></td>
				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=9087&amp;sid=3e4b5a2a03e170ff17f00e7370b40c1c"><img src="templates/Chronicles/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
