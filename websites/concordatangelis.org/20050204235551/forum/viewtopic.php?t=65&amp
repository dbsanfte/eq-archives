				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=9078&amp;sid=c2fe5f1ae2cca10913afe104dcbfa14f"><img src="templates/Chronicles/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
