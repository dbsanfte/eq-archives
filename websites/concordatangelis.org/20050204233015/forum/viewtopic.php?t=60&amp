				<td width="100%"><a href="viewtopic.php?p=8967&amp;sid=fd96919f5a5ba7bb1503e8ff236ec1b5#8967"><img src="templates/Chronicles/images/icon_minipost.gif" width="12" height="9" alt="Post" title="Post" border="0" /></a><span class="postdetails">Posted: Fri Jul 20, 2001 2:25 pm<span class="gen">&nbsp;</span>&nbsp; &nbsp;Post subject: </span></td>
				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=8967&amp;sid=fd96919f5a5ba7bb1503e8ff236ec1b5"><img src="templates/Chronicles/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
