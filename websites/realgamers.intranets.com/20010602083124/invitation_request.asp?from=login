<!--

var myForm;
var myImage;
function getForm(formName, layerName) {
   if (document.layers) {
      if (layerName.length) {
         return eval('document.layers[\'' + layerName + '\'].document.' + formName);
      }
      else {
         return eval('document.' + formName);
      }
   }
   else {
      if (document.all) {
         return eval('document.all.' + formName);
      }
      else {
         return document.getElementsByName(formName)[0];
      }
   }
}
function ValidateForm(form)
{
   if (!Jtrim(form.in_name_first.value).length) {
      alert("Please enter your first name.");
      return false;
   }
   if (!Jtrim(form.in_name_last.value).length) {
      alert("Please enter your last name.");
      return false;
   }
   if (!isValidEmail(form.in_email.value)) {
      alert("Please enter a valid email address.");
      return false;
   }
   if (!Jtrim(form.in_message.value).length) {
      alert("Please enter your message.");
      return false;
   }
   return true;
}
function Jtrim(st)
{
   var len=st.length;
   var begin=0, end=len-1;
   while (st.charAt(begin) == " " && begin < len) { begin++; }
   while (st.charAt(end) == " " && end > begin) {  end--;  }
   return st.substring(begin, end+1);
}
function isValidEmail(str)
{
   var apos = str.indexOf("@");
   var dpos = str.indexOf(".");
   var epos = str.indexOf("]");
   var fpos = str.indexOf("[");
   if (apos<=0 || dpos<=0 || epos>0 || fpos>0)
       return false;
   if (dpos+1>=str.length)
       return false;
   return true;
}
function setimgsrc(imageName, imageLocation)
{
   if (navigator.appName == 'Netscape' && parseInt(navigator.appVersion) <= 4)
   {
       myImage = top.document.layers['site-page-contents'].document.images;
   }
   else
   {
       myImage = document.images;
   }
   if (myImage) myImage[imageName].src = imageLocation;
   return true; 
} 
var firsttime = 0;   
function sendform( commandname, value )
{
   myForm = getForm('requestForm', 'site-page-contents');
   if ( firsttime == 0 ){ 
      firsttime = 1; 
      var k = -1; 
      for ( i = 0; i < myForm.elements.length; i++ ) { 
         var name = myForm.elements[i].name; 
         name = name + ""; 
         if ( name == commandname && myForm.elements[i].type == "hidden" ) { 
            k = i; 
         } 
      } 
      if ( k == -1 ){
         alert('Command field not found');
      }
      else {
         firsttime = 0;
         myForm.elements[k].value = value; 
         if (ValidateForm(myForm)) {
            myForm.submit(); 
         }
      }
   } 
}
self.focus();
function goFocus() 
{
   myForm = getForm('requestForm', 'site-page-contents');
   if (myForm)
      myForm.in_name_first.focus();
}
setTimeout("goFocus();",1000);

// -->
