90;&#12356;&#12394;&#12363;&#12387;&#12383;&#22580;&#21512;&#12395;&#12399;&#12522;&#12473;&#12488;&#12363;&#12425;&#38500;&#22806;&#12375;&#12414;&#12377;&#12290;Pearl&#12364;&#29992;&#24847;&#12391;&#12365;&#12383;&#26178;&#12395;&#12399;&#12414;&#12383;&#12522;&#12473;&#12488;&#12395;&#21152;&#12431;&#12427;&#20107;&#12364;&#12391;&#12365;&#12414;&#12377;&#12290;<br /><br /><br />&#12371;&#12371; &#12391;&#29694;&#22312;&#12398;&#12522;&#12473;&#12488;&#12392;&#27425;&#12364;&#35504;&#12398;&#30058;&#12363;&#30906;&#35469;&#12391;&#12365;&#12414;&#12377;&#12290;<br /><br />5. &#30331;&#37682;&#12395;&#12399;&#24517;&#12378;&#20104;&#32004;(Reservation)&#12479;&#12464;&#12434;&#12388;&#12369;&#12390;&#19979;&#12373;&#12356;&#12290;&#12371;&#12428;&#12425;&#12399;&#36969;&#20999;&#12395;&#20351;&#12387;&#12390;&#19979;&#12373;&#12356;&#65288;&#19979;&#35352;&#21442;&#29031;&#65289;&#12290;<br /><br />6. &#12354;&#12394;&#12383;&#12398;Guild&#12391;&#12414;&#12378;&#36948;&#25104;&#12391;&#12365;&#12394;&#12356;&#12392;&#24605;&#12431;&#12428;&#12427;&#12418;&#12398;&#12289;&#12354;&#12427;&#12356;&#12399;&#35336;&#30011;&#12377;&#12425;&#12375;&#12390;&#12356;&#12394;&#12356;&#12418;&#12398;&#12399;&#20104;&#32004;&#12375;&#12394;&#12356;&#12391;&#12367;&#12384;&#12373;&#12356;&#12290;&#20840;&#28357;&#12375;&#12390;&#30446;&#30340;&#12364;&#36948;&#25104;&#12391;&#12365;&#12394;&#12356;&#12398;&#12399;&#32080;&#27083;&#12394;&#12398;&#12391;&#12377;&#12364;&#12289;&#21336;&#12395;&#20182;&#12398;&#20154;&#12364;&#20351;&#12360;&#12394;&#12367;&#12394;&#12427;&#12398;&#12391;&#20104;&#32004;&#12399;&#25511;&#12360;&#12390;&#12367;&#12384;&#12373;&#12356;&#12290;&#12418;&#12375;&#12418;&#35336;&#30011;&#12375;&#12390;&#12356;&#12383;&#12418;&#12398;&#12434;&#20013;&#27490;&#12377;&#12427;&#12371;&#12392;&#12395;&#12375;&#12383;&#22580;&#21512;&#12399;&#12289;&#12383;&#12392;&#12360;&#26368;&#24460;&#12398;&#19968;&#20998;&#12391;&#12354;&#12387;&#12390;&#12418;&#123