				<td valign="top" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=53993&amp;sid=2259e0496140a83a4efb9e95e3bd9e4c"><img src="templates/bsrf/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
