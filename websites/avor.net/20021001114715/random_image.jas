today=new Date();
jran=today.getTime();
function rnd() {
	ia=9301;
	ic=49297;
	im=233280;
	jran = (jran*ia+ic) % im;
	return jran/(im*1.0);
};

function rand(number) {
	return Math.ceil(rnd()*number);
};

for(i=1;i<=1;i++) {
	myNum=(rand(3));
	if(myNum == 1) document.write("<img src='graphics/upper_left_orc.gif'>");
	if(myNum == 2) document.write("<img src='graphics/upper_left_human.gif'>");
	if(myNum == 3) document.write("<img src='graphics/upper_left_medic.gif'>");
};
