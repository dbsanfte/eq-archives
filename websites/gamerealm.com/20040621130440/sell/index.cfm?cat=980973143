<script language="JavaScript">

// Opens a new browser window with no titlebar and the given size, and
// loads the given URL into it.
function openWindow (URL, width, height){
  window.open (URL, "previewWindow", "scrollbars=1,resizable=1,toolbar=no,statusbar=no,width=" + width + ",height=" + height);
}

function doThis(){
  if (document.item_input.thumb.value==""){
    document.item_input.featured_studio.checked=false
    alert("Thumbnail Source above is empty.\nPlease indicate the thumbnail URL source.")
  } 
}   

function theRFlag(){
  if (document.forms["item_input"].auction_mode.value == "1"){
    document.theFlag.src="../images/r_reverse.gif"
    document.forms["item_input"].maximum_bid.value=document.forms["item_input"].minimum_bid.value
    document.forms["item_input"].minimum_bid.value=0
    document.forms["item_input"].reserve_bid.value = document.forms["item_input"].maximum_bid.value
  }else{
    document.theFlag.src="../images/r_reverse_blank.gif"
    document.forms["item_input"].minimum_bid.value=document.forms["item_input"].maximum_bid.value
    document.forms["item_input"].maximum_bid.value=0
    document.forms["item_input"].reserve_bid.value = 0      
  }
} 

function singleItem(){ 
  if (document.forms["item_input"].quantity.value > 1){
    document.forms["item_input"].dynamic_valu.focus()
  }
}    

function reverseItem(){
  if (document.forms["item_input"].auction_mode.value == 1){
     document.forms["item_input"].reserve_bid.value = document.forms["item_input"].maximum_bid.value
//     document.forms["item_input"].increment_valu.focus() 
  }
}    

function chk_minmax(parm){
  if ((parm == "min")&&(document.forms["item_input"].auction_mode.value == "1")){
    document.forms["item_input"].maximum_bid.focus()
  }
  if ((parm == "max")&&(document.forms["item_input"].auction_mode.value == "0")){
    if (document.forms["item_input"].minimum_bid.value == 0){
      document.forms["item_input"].minimum_bid.focus()
    }else{
      document.forms["item_input"].reserve_bid.focus()
    }      
  } 
}

</script>




  
   












