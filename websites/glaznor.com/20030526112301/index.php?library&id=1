					<TR><TD align="center" colspan="3" background="images/h-c.jpg" style="color:#D4D0C5"><B>General Loot Policy for LSoG raids</B></TD></TR>
					<TR><TD colspan="3" background="images/h-c.jpg"><IMG src="images/blank.gif" width="1" height="2" border="0"></TD></TR>
					<TR><TD colspan="3"><IMG src="images/blank.gif" width="1" height="6" border="0"></TD></TR>
