        &nbsp;<a href="post.asp?ARCHIVE=&method=ReplyQuote&REPLY_ID=50650&TOPIC_ID=8308&FORUM_ID=27&CAT_ID=6&Forum_Title=World+of+Warcraft&Topic_Title=Which+of+these+is+better+and+why%3F&M="><img src="icon_reply_topic.gif" height=15 width=15 alt="Reply with Quote" border="0" align="absmiddle" hspace="6"></a>

