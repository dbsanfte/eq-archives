		<font color="midnightblue" face="Verdana, Arial, Helvetica" size="2"><b>Kaashar</a>
        </b></font>

        <br><font color="midnightblue" face="Verdana, Arial, Helvetica" size="1"><small>Old Member</small></font>

		<br><img src="http://home.nc.rr.com/corral/tinyduck.gif" alt="Kaashar" width="60" height="60" border=0 hspace="2" vspace="2">
		

        <br>
        <br><font color="midnightblue" face="Verdana, Arial, Helvetica" size="1"><small> </small></font>
