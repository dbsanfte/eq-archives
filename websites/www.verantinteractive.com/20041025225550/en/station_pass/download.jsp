	// The function will look for a cookie named "animated". 
	// If it does not find it, set a variable named "animateMe" 
	// to true, then write out a cookie named "animate" and 
	// set it to expire in 24 hours. If it does find the cookie, 
	// then set a variable named "animateMe" to false. 

	var animateMe=true;
	animatecookie=ndgetCookie("animate");
	if (animatecookie)
	{
		if (animatecookie=="set")
		{
			animateMe=false;
		}
	}
	if (animateMe==true)
	{
		ndsetCookie("animate", "set", "day");
	}
</script>
