		<table width="100%" border="0" cellspacing="0" cellpadding="1" bgcolor="Black">
		<tr>
			<td><table width="100%" border="0" cellspacing="0" cellpadding="2" bgcolor="White">
		<tr>
			<td width="100%" bgcolor="#E0DEC5"><font color="black" size="-1" face="arial">&nbsp;<b>Digest of Developers</b></font></td>
		</tr>
		</table></td>
