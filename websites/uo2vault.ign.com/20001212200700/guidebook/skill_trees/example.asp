<tr>
	<td colspan="4"></td>
	<td valign="top"><img src="skill_box.gif" width="55" height="49" border="0" alt=""></td>
	<td valign="top"><font face="Arial" size="-1"><b>Sword Smithing</b></font><br><font face="Arial" size="-2">Requirements: Blunt Weapon Smithing<br>Description: Allows creation of swords<br>Allows: <br>Notes: Entrance into Sword Smithing Branch</font></td>
	<td valign="top"><img src="skill_box.gif" width="55" height="49" border="0" alt=""></td>
	<td valign="top"><font face="Arial" size="-1"><b>Axe Smithing</b></font><br><font face="Arial" size="-2">Requirements: Blunt Weapon Smithing<br>Description: Allows creation of axes<br>Allows: <br>Notes: Entrance into Axe Smithing Branch</font></td>
</tr>

