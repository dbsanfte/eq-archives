		<td class="row1" width="100%" height="28" valign="top"><table width="100%" border="0" cellspacing="0" cellpadding="0">
			<tr>
				<td width="100%"><a href="viewtopic.php?p=41&amp;sid=f221914eed385e059514ae5ca93b02d9#41"><img src="templates/Appalachia/images/icon_minipost.gif" width="12" height="9" alt="Post" title="Post" border="0" /></a><span class="postdetails">Posted: Tue Sep 09, 2003 8:08 pm<span class="gen">&nbsp;</span>&nbsp; &nbsp;Post subject: Past Lives.</span></td>
				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=41&amp;sid=f221914eed385e059514ae5ca93b02d9"><img src="templates/Appalachia/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
