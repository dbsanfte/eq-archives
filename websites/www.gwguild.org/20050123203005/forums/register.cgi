	<center><a href="forums.cgi"><img src="/forums/images/banner3.jpg" border=0 alt="Nameless Guild"></a></center><br>



	<style type="text/css">

	  td {
	    font-family: verdana;
		font-size:   10pt;
      }

	  .forum-title {
	  	font-family: verdana;
		font-size:   10pt;
