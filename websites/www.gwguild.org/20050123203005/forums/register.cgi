	  }

	 .forum-header {
	  	font-family: verdana;
		font-size:   10pt;
		font-weight: bold;
	 }

	 .forum-header-small {
        font-family: "verdana";
        font-size:   10pt;
        font-weight: bold;
		text-decoration: underline;
	 }
	 .normal-small {
	 	font-family: verdana;
		font-size:   8pt;
	 }


	  A:link {text-decoration: underline;}
	  A:visited {text-decoration: underline;}
	  A:active {text-decoration: underline;}
