<form method=POST action="register.cgi">
<input type=hidden name="posting" value="1">

<center>

<table border=0 cellpadding=0 cellspacing=0>
<tr>
	<td bgcolor=black>

	<table border=0 cellpadding=4 cellspacing=1>
	<tr>
		<td colspan=2 bgcolor=#79AEDB align=center><b>Nameless Guild Registration</td>
	</tr>
	<tr>
		<td bgcolor=#B6D3EC>Desired Username:</td>
		<td bgcolor=#E2E8ED><input type=text name="user_name"></td>
	</tr>
	<tr>
		<td bgcolor=#B6D3EC>Password:</td>
		<td bgcolor=#E2E8ED><input type=password name="pass1"></td>
	</tr>
		<tr>
		<td bgcolor=#B6D3EC>Confirm Password:</td>
		<td bgcolor=#E2E8ED><input type=password name="pass2"></td>
	</tr>
	<tr>
		<td bgcolor=#B6D3EC>Personal Blurb (64 chars):</td>
		<td bgcolor=#E2E8ED><input type=text name="blurb"></td>
	</tr>
	</table>

	</td>
</tr>
</table><p>

<input type=submit value="Register"> <input type=button value=" Forum Index " onClick="self.location.href='forums.cgi'">

