<center>



<table width=100%><tr><td align=center>

<b>Nameless Guild: Sign In</b><p>

<form method=POST action="login.cgi">
<input type=hidden name="posting" value="1">
<input type=hidden name="return" value="forums.cgi">

<table border=0 cellpadding=0 cellspacing=0>
<tr>
	<td bgcolor=black>

	<table border=0 cellpadding=4 cellspacing=1>
	<tr>
		<td bgcolor=#B6D3EC>Username:</td>
		<td bgcolor=#E2E8ED><input type=text name="username"></td>
	</tr>
	<tr>
		<td bgcolor=#B6D3EC>Password:</td>
		<td bgcolor=#E2E8ED><input type=password name="password"></td>
	</tr>
	<tr>
		<td colspan=2 bgcolor=#E2E8ED><input type=checkbox name="week" checked> Keep me signed in for a week</td>
	</tr>
	</table>

	</td>
</tr>
</table><p>

<input type=submit value="Sign In"><p>

Dont have a login?  <a href="register.cgi">Create one here</a>.

</form>

