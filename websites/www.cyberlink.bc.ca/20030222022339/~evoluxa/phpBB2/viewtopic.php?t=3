				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=3&amp;sid=6cd7eb1be2aeb6a9a09e05ad235ef5e2"><img src="templates/subTrail/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
