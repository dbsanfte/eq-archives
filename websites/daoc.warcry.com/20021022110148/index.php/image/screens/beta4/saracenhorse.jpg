      <html>
      <head>
        <title>Camelot Warcry - Image</title>
      </head>
      <style>
        BODY {
  background : #D6D0C0 url('http://daoc.warcry.com/themes/default/gfx/background.jpg');
  color : #000000;
  font-family : Verdana, Arial, Helvetica;
  font-size : 10pt;
  }
  
TD, .BaseFont {
  color : #000000;
  font-family : Verdana, Arial, Helvetica;
  font-size : 10pt;
  }
  
.NewsHeading {
  font-family : Arial, Helvetica;
  font-size : 11pt;
  font-weight : bold;
  }

.NewsFont {
  color : #000000;
  font-family : Verdana, Arial, Helvetica;
  font-size : 10pt;
  }

.NewsQuote {
  color : #25200B;
  font-style : italic;
  }
.NewsSmallHead  {
  font-family : Arial, Helvetica;
  font-size : 10pt;
  font-weight : bold;
  color : #E5E0CB;
  }

A.NewsSmallHead {
  color : #E5E0CB;
  text-decoration : none;
  }

A:Visited.NewsSmallHead {
  color : #E5E0CB;
  text-decoration : none;
  }
  
A:Hover.NewsSmallHead {
  color : #E5E0CB;
  text-decoration : underline;
  }

.SmallFont {
  font-family : Arial, Helvetica;
  font-size : 8pt;
  }

.DevTeam {
  font-weight : bold;
  color : #AA0000;
  }

.LegalNotes {
  font-family : Arial, Helvetica;
  font-size : 7pt;
  }

A {
  color : #990000;
  text-decoration : none;
  }

A:Visited {
  color : #660000;
  text-decoration : none;
  }
  
A:Hover {
  color : #660033;
  text-decoration : underline;
  }

.MenuHeader {
  color : #E5E0CB;
  font-family : Verdana, Arial, Helvetica;
  font-size : 8pt;
  font-weight : bold;
  }

.SmMenuHeader {
  color : #E5E0CB;
  font-family : Arial, Helvetica;
  font-size : 8pt;
  font-weight : bold;
  }

A.MenuHeader {
  color : #FFFFFF;
  text-decoration : none;
  }

A:Visited.MenuHeader {
  color : #FFFFFF;
  text-decoration : none;
  }
  
A:Hover.MenuHeader {
  color : #E5E0CB;
  text-decoration : none;
  }

.MenuItem {
  color : #FFFFFF;
  font-family : Verdana, Arial, Helvetica;
  font-size : 8pt;
  }

A.MenuItem {
  color : #FFFFFF;
  text-decoration : none;
  }

A:Visited.MenuItem {
  color : #FFFFFF;
  text-decoration : none;
  }
  
A:Hover.MenuItem {
  color : #E5E0CB;
  text-decoration : underline;
  }

.SmMenuItem {
  color : #FFFFFF;
  font-family : Arial, Helvetica;
  font-size : 8pt;
  }

A.SmMenuItem {
  color : #FFFFFF;
  text-decoration : none;
  }

A:Visited.SmMenuItem {
  color : #FFFFFF;
  text-decoration : none;
  }
  
A:Hover.SmMenuItem {
  color : #E5E0CB;
  text-decoration : underline;
  }

A.SmallDate {
  color : #CCCCCC;
  text-decoration : none;
  font-weight:bold;
  }

A:Visited.SmallDate {
  color : #CCCCCC;
  text-decoration : none;
  font-weight:bold;
  }
  
A:Hover.SmallDate {
  color : #FFFFFF;
  text-decoration : none;
  font-weight:bold;
  }
  
.BoardToolBG, .TblDate {
  background: #000000 url('http://daoc.warcry.com/themes/default/gfx/tbldate.gif');
  height:20;
  color : #FFFFFF;
  }
  
.BoardTool, A.BoardTool, A:Visited.BoardTool {
  color : #FFFFFF;
  font-family : Arial, Helvetica;
  font-size : 8pt;
  text-decoration : none;
  }
  
A:Hover.BoardTool {
  color : #FFCC00;
  text-decoration : none;
  }
  
.DropDown {
  border: 1px solid #000000;
  font-family : Verdana,Arial,Helvetica;
  font-size : 8pt;
  color : #000000;
  background : #B5B09B;
  }
  
.FlatMode2, .listName {
  background : #C5C0AB; 
  }

.FlatMode1, .listDefinition {
  background : #B5B09B; 
  }

.FlatData, .listHeader {
  background : #A5A08B; 
  }

.listNameOff {
  background : #C5C0AB; 
  color : #B5B09B;
  }

.MsgAuthorFont {
  font-weight : bold;
  }

.NewMsg {
  font-family : Arial, Helvetica;
  font-size : 8pt;
  color : #EEEEEE;
  font-weight: bold;
  }

.DateFont {
  font-weight : bold;
  }
  
.CalendarBG {
  background : #D6D0C0;
  }
  
.CalendarText {
  color : #000000;
  }
  
.CalendarBorder {
  background : #000000;
  }      </style>

