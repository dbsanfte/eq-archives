function getHostStr(str){
var res=getSplitStr(str, ".");res=getSplitStr(res, ":");res=getSplitStr(res, "-");
return res;
}
function getSplitStr(str, del){
var res="";
var arr=str.split(del);
for(var i=0; i<arr.length; i++){
	if (res!="") res=res+"_";res=res+arr[i];
}
return res;
}