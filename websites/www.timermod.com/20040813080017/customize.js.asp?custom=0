	baseHEnd0[i] = new Image();
	baseHEnd0[i].src = "image/base/" + base[i] + "/H/end0.png";
	baseHIcon1[i] = new Image();
	baseHIcon1[i].src = "image/base/" + base[i] + "/H/icon1.png";
	baseHEnd1[i] = new Image();
	baseHEnd1[i].src = "image/base/" + base[i] + "/H/end1.png";

	baseVIcon0[i] = new Image();
	baseVIcon0[i].src = "image/base/" + base[i] + "/V/icon0.png";
	baseVEnd0[i] = new Image();
	baseVEnd0[i].src = "image/base/" + base[i] + "/V/end0.png";
	baseVIcon1[i] = new Image();
	baseVIcon1[i].src = "image/base/" + base[i] + "/V/icon1.png";
	baseVEnd1[i] = new Image();
	baseVEnd1[i].src = "image/base/" + base[i] + "/V/end1.png";
