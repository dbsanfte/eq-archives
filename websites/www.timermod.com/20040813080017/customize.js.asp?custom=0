function UpdatePage()
{
	document.forms.customize.back.style.display = Number(document.forms.customize.page.value) == 0 ? "none" : "";
	document.getElementById("IE").style.display = Number(document.forms.customize.page.value) == 0 ? "" : "none";
	document.forms.customize.next.style.display = Number(document.forms.customize.page.value) == (page.length - 1) ? "none" : "";
	document.forms.customize.download.style.display = Number(document.forms.customize.page.value) == (page.length - 1) ? "" : "none";

	document.getElementById("page" + document.forms.customize.page.value).style.display = "";
	page[Number(document.forms.customize.page.value)].update();
}

function Back()
{
	if (Number(document.forms.customize.page.value) > 0)
	{
		document.getElementById("page" + document.forms.customize.page.value).style.display = "none";
		document.forms.customize.page.value = Number(document.forms.customize.page.value) - 1;
		UpdatePage();
		scrollTo(0, 0);
	}
}

function Next()
{
	if (Number(document.forms.customize.page.value) < page.length - 1 && page[Number(document.forms.customize.page.value)].validate())
	{
		document.getElementById("page" + document.forms.customize.page.value).style.display = "none";
		document.forms.customize.page.value = Number(document.forms.customize.page.value) + 1;
		UpdatePage();
		scrollTo(0, 0);
	}
}

function UpdateForm()
{
	document.getElementById("loading").style.display = "none";
	UpdatePage();
}

function ValidateName()
{
	var name = document.forms.edit["name"].value;
	var pattern = /^[!-~]([!-~ ]{0,30}[!-~])?$/;

	if (pattern.test(name))
		return true;

	alert("Please enter a different name. Rules:\n- name must contain between 1 and 32 characters\n- only use characters found on a standard US keyboard\n- name cannot begin or end with a space");
	document.forms.edit["name"].select();
	return false;
}

function ValidateDuration()
{
	if (document.forms.edit["hours"].value > 0 ||
		document.forms.edit["minutes"].value > 0 ||
		document.forms.edit["seconds"].value > 0)
		return true;
		
	alert("Please enter a duration greater than 0:00:00.");
	return false;
}

var icons = new Array(34);
var iconsLoaded = false;
function LoadIcons()
{
	if (iconsLoaded) return;
	iconsLoaded = true;
	for (i = 0; i < 34; i++)
	{
		icons[i] = new Image(240, 240);
		if (i < 7)
			icons[i].src = "image/icon/Spells0" + (Number(i) + 1) + ".png";
		else
			icons[i].src = "image/icon/dragitem" + (Number(i) - 6) + ".png";
	}
}

function ChangeIcon(x, y)
{
	if (document.forms.edit["tga"].value == "Spells07")
	{
		if (x > 0 || y > 0)
			return;
	}
	else if (document.forms.edit["tga"].value == "dragitem21")
	{
		if (x == 1 && y == 4)
			return;
	}
	else if (document.forms.edit["tga"].value == "dragitem27")
	{
		if ((x == 4 && y >= 3) || x == 5)
			return;
	}

	document.forms.edit["icon-tga"].value = document.forms.edit["tga"].value;
	document.forms.edit["icon-x"].value = x;
	document.forms.edit["icon-y"].value = y;

	UpdateIcon();
}

function UpdateIcons()
{
	document.images["edit-icons"].src = "image/icon/" + document.forms.edit["tga"].value + ".png";
}

function LoadData(t)
{
	// close calculator if open
	if (document.forms.edit.calc.value == "<< Calculator")
		ToggleCalc();

	// label
	var label = String(document.forms.customize["label." + t].value);
	document.forms.edit["name"].value = label.substr(0, label.length - 10);
	
	// duration
	var duration = Number(document.forms.customize["duration." + t].value);
	document.forms.edit["hours"].value = Math.floor(duration / 3600);
	document.forms.edit["minutes"].value = Math.floor((duration % 3600) / 60);
	document.forms.edit["seconds"].value = duration % 60;

	// color
	document.getElementById("edit-color-" + document.forms.customize["color." + t].value).checked = true;
	
	// marker
	document.getElementById("edit-marker-" + document.forms.customize["marker." + t].value).checked = true;
	
	// icon
	document.forms.edit["icon-tga"].value = document.forms.customize["icon-tga." + t].value;
	document.forms.edit["icon-x"].value = document.forms.customize["icon-x." + t].value;
	document.forms.edit["icon-y"].value = document.forms.customize["icon-y." + t].value;
}

function SaveData(t)
{
	// label	
	document.forms.customize["label." + t].value =
		document.forms.edit["name"].value + " (" +
		document.forms.edit["hours"].value + ":" +
		(document.forms.edit["minutes"].value < 10 ? "0" : "") + document.forms.edit["minutes"].value + ":" +
		(document.forms.edit["seconds"].value < 10 ? "0" : "") + document.forms.edit["seconds"].value + ")";

	// duration
	document.forms.customize["duration." + t].value = 
		Number(document.forms.edit["hours"].value * 3600) +
		Number(document.forms.edit["minutes"].value * 60) +
		Number(document.forms.edit["seconds"].value);

	// color
	for (i = 0; i < color.length; i++)
	{
		if (document.getElementById("edit-color-" + color[i]).checked)
		{
			document.forms.customize["color." + t].value = color[i];
			break;
		}
	}
	
	// marker
	document.forms.customize["marker." + t].value = document.getElementById("edit-marker-2").checked ? "2" : "1";
	
	// icon
	document.forms.customize["icon-tga." + t].value = document.forms.edit["icon-tga"].value;
	document.forms.customize["icon-x." + t].value = document.forms.edit["icon-x"].value;
	document.forms.customize["icon-y." + t].value = document.forms.edit["icon-y"].value;
}

function UpdateIcon()
{
	// icon
	document.images["edit-icon"].src = "image/icon/" + document.forms.edit["icon-tga"].value + "/" +
		String(document.forms.edit["icon-x"].value) + String(document.forms.edit["icon-y"].value) + ".png";
}

function UpdateEdit()
{
	UpdateIcon();
	UpdateIcons();
}

function ValidateEdit()
{
	return ValidateName() && ValidateDuration();
}



function ToggleCalc()
{
	if (document.forms.edit.calc.value == "Calculator >>")
	{
		document.forms.edit.calc.value = "<< Calculator";
		document.getElementById("calc-view").style.display = "";
		
		UpdateModifier();
		UpdateCalcModifier();
		UpdateCalcSection();
	}
	else
	{
		document.forms.edit.calc.value = "Calculator >>";
		document.getElementById("calc-view").style.display = "none";
	}
}

function UpdateModifier()
{
	document.forms.edit["modifier-duration-aa"].disabled = document.forms.edit["modifier-duration-focus"].disabled =
		document.forms.edit["modifier-reuse-aa"].selectedIndex != 0;

	document.forms.edit["modifier-reuse-aa"].disabled =
		document.forms.edit["modifier-duration-aa"].selectedIndex != 0 || document.forms.edit["modifier-duration-focus"].selectedIndex != 0;
}

function UpdateCalcModifier()
{
	document.forms.edit["calc-modifier"].disabled = (
		document.forms.edit["base-hours"].value == 0 &&
		document.forms.edit["base-minutes"].value == 0 &&
		document.forms.edit["base-seconds"].value == 0) || (
		document.forms.edit["modifier-duration-aa"].selectedIndex == 0 &&
		document.forms.edit["modifier-duration-focus"].selectedIndex == 0 &&
		document.forms.edit["modifier-reuse-aa"].selectedIndex == 0);
}

function UpdateCalcSection()
{
	document.forms.edit["calc-section"].disabled = (
		document.forms.edit["section-minutes"].value == 0 &&
		document.forms.edit["section-seconds"].value == 0);
}

function CalcModifier()
{
	var duration = 
		Number(document.forms.edit["base-hours"].value * 3600) +
		Number(document.forms.edit["base-minutes"].value * 60) +
		Number(document.forms.edit["base-seconds"].value);

	if (document.forms.edit["modifier-duration-aa"].selectedIndex != 0 || document.forms.edit["modifier-duration-focus"].selectedIndex != 0)
	{
		duration += Math.floor(duration * (Number(document.forms.edit["modifier-duration-aa"].value) + Number(document.forms.edit["modifier-duration-focus"].value)) / 100);
	}
	else if (document.forms.edit["modifier-reuse-aa"].selectedIndex != 0)
	{
		duration = Math.floor(Number(eval(String(duration) + String(document.forms.edit["modifier-reuse-aa"].value))));
		if (duration < 0)
			duration = 0;
	}

	ApplyDuration(duration);
}

function CalcSection()
{
	var duration = 
		Number(document.forms.edit["section-minutes"].value * 60) +
		Number(document.forms.edit["section-seconds"].value);
		
	duration *= (Number(document.forms.customize.size.value) / 16);

	ApplyDuration(duration);
}

function ApplyDuration(duration)
{
	document.forms.edit.hours.value = Math.floor(duration / 3600);
	document.forms.edit.minutes.value = Math.floor((duration % 3600) / 60);
	document.forms.edit.seconds.value = duration % 60;
}

function UpdateSections()
{
	document.forms.edit.sections.value = (document.forms.customize.size.value / 16) + " sections.";
}