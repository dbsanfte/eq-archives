function ChangeBase(i)
{
	if (document.forms.customize.rotate.checked)
		document.forms.customize["base-horizontal-" + i].checked = true;
	else
		document.forms.customize["base-vertical-" + i].checked = true;
	document.forms.customize.base.value = base[i];
}

function ChangeDimensions()
{
	if (document.forms.customize.rotate.checked)
		document.forms.customize.dimensions.value = "22 x " + String(Number(document.forms.customize.size.value) + 25) + " pixels (W x H).";
	else
		document.forms.customize.dimensions.value = String(Number(document.forms.customize.size.value) + 25) + " x 22 pixels (W x H).";
}

function UpdateBaseRotate()
{
	document.getElementById("horizontal").style.display = document.forms.customize.rotate.checked ? "none" : "";
	document.getElementById("vertical").style.display = document.forms.customize.rotate.checked ? "" : "none";

	UpdateBaseFlip();
	UpdateBaseSize();
}

function UpdateBaseFlip()
{
	if (document.forms.customize.flip.checked)
	{
		if (document.forms.customize.rotate.checked)
		{
			for (i = 0; i < base.length; i++)
			{
				document.getElementById("top-" + base[i]).style.height = "3px";
				document.getElementById("bottom-" + base[i]).style.height = "22px";
				document.getElementById("top-" + base[i]).style.backgroundImage = "url(" + baseVEnd1[i].src + ")";
				document.getElementById("bottom-" + base[i]).style.backgroundImage = "url(" + baseVIcon1[i].src + ")";
			}
		}
		else
		{
			for (i = 0; i < base.length; i++)
			{
				document.getElementById("left-" + base[i]).style.width = "3px";
				document.getElementById("right-" + base[i]).style.width = "22px";
				document.getElementById("left-" + base[i]).style.backgroundImage = "url(" + baseHEnd1[i].src + ")";
				document.getElementById("right-" + base[i]).style.backgroundImage = "url(" + baseHIcon1[i].src + ")";
			}
		}
	}
	else
	{
		if (document.forms.customize.rotate.checked)
		{
			for (i = 0; i < base.length; i++)
			{
				document.getElementById("top-" + base[i]).style.height = "22px";
				document.getElementById("bottom-" + base[i]).style.height = "3px";
				document.getElementById("top-" + base[i]).style.backgroundImage = "url(" + baseVIcon0[i].src + ")";
				document.getElementById("bottom-" + base[i]).style.backgroundImage = "url(" + baseVEnd0[i].src + ")";
			}
		}
		else
		{
			for (i = 0; i < base.length; i++)
			{
				document.getElementById("left-" + base[i]).style.width = "22px";
				document.getElementById("right-" + base[i]).style.width = "3px";
				document.getElementById("left-" + base[i]).style.backgroundImage = "url(" + baseHIcon0[i].src + ")";
				document.getElementById("right-" + base[i]).style.backgroundImage = "url(" + baseHEnd0[i].src + ")";
			}
		}
	}
}

function UpdateBaseSize()
{
	if (document.forms.customize.rotate.checked)
	{
		for (i = 0; i < base.length; i++)
		{
			document.getElementById("middle-" + base[i]).style.height = Number(document.forms.customize.size.value);
		}
	}
	else
	{
		for (i = 0; i < base.length; i++)
		{
			document.getElementById("center-" + base[i]).style.width = Number(document.forms.customize.size.value);
		}
	}
}

function DisableBaseRequired()
{
	if (document.forms.customize["_size"].value == "*") document.forms.customize.size.disabled = true;
	if (document.forms.customize["_rotate"].value == "*") document.forms.customize.rotate.disabled = true;
	if (document.forms.customize["_flip"].value == "*") document.forms.customize.flip.disabled = true;
}

function EnableBaseRequired()
{
	if (document.forms.customize["_size"].value == "*") document.forms.customize.size.disabled = false;
	if (document.forms.customize["_rotate"].value == "*") document.forms.customize.rotate.disabled = false;
	if (document.forms.customize["_flip"].value == "*") document.forms.customize.flip.disabled = false;
}

