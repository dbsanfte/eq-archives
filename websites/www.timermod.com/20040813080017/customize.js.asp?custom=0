var doc, rotate, flip;

function w(x) { return (document.forms.customize.rotate.checked ? "height" : "width") + ": " + x + "px;"; }
function h(y) { return (document.forms.customize.rotate.checked ? "width" : "height") + ": " + y + "px;"; }
function W(x) { return " " + (document.forms.customize.rotate.checked ? "HEIGHT" : "WIDTH") + "=" + x; }
function H(y) { return " " + (document.forms.customize.rotate.checked ? "WIDTH" : "HEIGHT") + "=" + y; }

function RandomOffset()
{
	return Math.floor(Math.random() * ((document.forms.customize.size.value - 6) / 2)) * 2;
}

function none() { }

function Preview()
{
	rotate = document.forms.customize.rotate.checked ? "V" : "H";

	var preview = document.getElementById("preview");
	
	var height = document.forms.customize.rotate.checked ? (Number(document.forms.customize.size.value) + 25) : 22;
	height += Number(document.forms.customize.spacing.value);
	height *= Number(document.forms.customize.rows.value);
	height += Number(document.forms.customize.spacing.value);
	height += 37 + (document.forms.customize.tabs.value > 0 ? 23 : 0) + 16;
	preview.style.height = height + "px";
	
	if (preview.contentWindow)
		doc = preview.contentWindow.document;
	else if (preview.contentDocument)
		doc = preview.contentDocument;
	else if (document.frames["preview"])
		doc = document.frames["preview"].document;
	else
	{
		alert("The preview is not supported by your browser, and will not be shown.");
		return;
	}

	doc.open("text/html", "replace");
	
	doc.writeln('<HTML><HEAD>');
	
	doc.writeln('<STYLE TYPE="text/css">');
	doc.writeln('BODY { margin-left: 8px; margin-top: 8px; margin-right: 8px; margin-bottom: 0px; background-color: #000000; }');
	if (document.forms.customize.tabs.value > 0)
	{
		var highlight = new Object;
		highlight["666666"] = "999999";
		highlight["999999"] = "CCCCCC";
		highlight["666633"] = "999966";
		highlight["999966"] = "CCCC99";
	
		doc.writeln('BODY, TD, INPUT, SELECT { font-family: Arial; font-size: 11px; }');
		doc.writeln('A { text-decoration: none; } A.active { color: #' + highlight[document.forms.customize.base.value] + '; } A.inactive { color: #' + document.forms.customize.base.value + '; }');
	}
	doc.writeln('</STYLE>');
	
	if (document.forms.customize.tabs.value > 0)
	{
		doc.writeln('<SCRIPT TYPE="text/javascript">');
		doc.writeln('var tab = "A";');
		doc.writeln('function ShowTab(t) { if (tab == t) return; document.getElementById("tab-" + tab).style.display = "none"; document.getElementById("link-" + tab).className = "inactive"; tab = t; document.getElementById("tab-" + tab).style.display = ""; document.getElementById("link-" + tab).className = "active"; }');
		doc.writeln('</SCR' + 'IPT>');
	}
	
	doc.writeln('</HEAD><BODY>');
	
	doc.writeln('<TABLE BORDER=0 CELLSPACING=8 CELLPADDING=0>');
	
	// tab stuff
	var tab = ["A"];
	if (document.forms.customize.tabs.value > 1) tab.push("B");
	if (document.forms.customize.tabs.value > 2) tab.push("C");
	if (document.forms.customize.tabs.value > 3) tab.push("D");
	
	if (document.forms.customize.tabs.value > 0)
	{
		doc.writeln('<TR>');
		for (var p = 0; p < tab.length; p++)
		{
			doc.writeln('<TD ALIGN=center><A ID="link-' + tab[p] + '" CLASS="' + (p == 0 ? "active" : "inactive") + '" HREF="javascript:ShowTab(\'' + tab[p] + '\')">' + document.forms.customize["tab." + tab[p]].value + '</A></TD>');
		}
		doc.writeln('</TR>');
	}
	
	doc.writeln('<TR><TD COLSPAN=' + tab.length + '>');
	
	for (var p = 0; p < tab.length; p++)
	{
		var t = 0;
		doc.writeln('<TABLE ID="tab-' + tab[p] + '" BORDER=0 CELLSPACING=' + document.forms.customize.spacing.value + ' CELLPADDING=0' + (p == 0 ? '' : ' STYLE="display: none"') + '>');
		for (var row = 0; row < document.forms.customize.rows.value; row++)
		{
			doc.writeln('<TR>')
			for (var col = 0; col < document.forms.customize.cols.value; col++)
			{
				doc.writeln('<TD>')
				PreviewTimer(tab[p] + (++t));
				doc.writeln('</TD>')
			}
			doc.writeln('</TR>')
		}
		doc.writeln('</TABLE>');
	}
	
	doc.writeln('</TD></TR>');
		
	var width = document.forms.customize.rotate.checked ? 22 : (Number(document.forms.customize.size.value) + 25);
	width += Number(document.forms.customize.spacing.value);
	width *= Number(document.forms.customize.cols.value);
	width += Number(document.forms.customize.spacing.value);
	doc.writeln('<TR><TD COLSPAN=' + tab.length + '><IMG SRC="image/blank.png" WIDTH=' + width + ' HEIGHT=1></TD></TR>');
//	doc.writeln('<IMG SRC="image/blank.png" WIDTH=' + width + ' HEIGHT=1>');

	doc.writeln('</TABLE>');
	doc.writeln('</BODY></HTML>');
	
	doc.close();
}

function PreviewTimer(timer)
{
	doc.writeln('<TABLE BORDER=0 CELLSPACING=0 CELLPADDING=0>');
	doc.writeln('<TR>');
	
	if (document.forms.customize.flip.checked)
	{
		doc.writeln('<TD STYLE="' + w(3) + h(22) + 'background-image: url(image/base/' + document.forms.customize.base.value + '/' + rotate + '/end1.png)"></TD>');
	}
	else
	{
		doc.write('<TD STYLE="' + w(22) + h(22) + 'background-image: url(image/base/' + document.forms.customize.base.value + '/' + rotate + '/icon0.png)" ALIGN=center VALIGN=middle>');
		PreviewIcon(timer);
		doc.writeln('</TD>');
	}
		
	if (document.forms.customize.rotate.checked) doc.writeln('	</TR><TR>');

	doc.writeln('<TD STYLE="' + w(document.forms.customize.size.value) + h(22) + 'background-image: url(image/base/' + document.forms.customize.base.value + '/' + rotate + '/bar.png)">');
	PreviewBar(timer);		
	doc.writeln('</TD>');
		
	if (document.forms.customize.rotate.checked) doc.writeln('</TR><TR>');

	if (document.forms.customize.flip.checked)
	{
		doc.write('<TD STYLE="' + w(22) + h(22) + 'background-image: url(image/base/' + document.forms.customize.base.value + '/' + rotate + '/icon1.png)" ALIGN=center VALIGN=middle>');
		PreviewIcon(timer);
		doc.writeln('</TD>');
	}
	else
	{
		doc.writeln('<TD STYLE="' + w(3) + h(22) + 'background-image: url(image/base/' + document.forms.customize.base.value + '/' + rotate + '/end0.png)"></TD>');
	}
	
	doc.writeln('</TR>');
	doc.writeln('</TABLE>');
}

function PreviewIcon(timer)
{
	doc.write('<A HREF="javascript:parent.none()" TITLE="' + document.forms.customize["label." + timer].value + '" ONMOUSEOVER="status=\'\'; return true">');
	doc.write('<IMG BORDER=0 WIDTH=16 HEIGHT=16 SRC="image/icon/' + document.forms.customize["icon-tga." + timer].value + '/' + document.forms.customize["icon-x." + timer].value + document.forms.customize["icon-y." + timer].value + '.png">');
	doc.write('</A>');
}

function PreviewBar(timer)
{
	var markerA = RandomOffset();
	var markerB = document.forms.customize["marker." + timer].value == "2" ? RandomOffset() : markerA;

	doc.writeln('<TABLE BORDER=0 CELLSPACING=0 CELLPADDING=0 WIDTH=100% HEIGHT=100%>');
	doc.writeln('<TR>');

	doc.write('<TD STYLE="' + h(3) + '" ALIGN=left VALIGN=top>');
	if (markerA) doc.write('<IMG SRC="image/blank.png"' + W(markerA) + H(3) + '>');
	doc.write('<IMG SRC="image/base/' + document.forms.customize.base.value + '/' + rotate + '/markerA_.png"' + W(8) + H(3) + '>');
