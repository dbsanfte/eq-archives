var number = new Array(8);
for (i = 0; i < 8; i++)
{
	number[i] = new Image(5, 7);
	number[i].src = "image/" + (Number(i) + 1) + ".png";
}

function InitializeLayout()
{
	if (document.forms.customize.rotate.checked)
	{
		for (var row = 1; row <= 8; row++)
		{
			for (var col = 1; col <= 8; col++)
			{
				document.getElementById("layout-" + col + row).style.width = "9px";
				document.getElementById("layout-" + col + row).style.height = "45px";
			}
		}
	}
	else
	{
		for (var row = 1; row <= 8; row++)
		{
			for (var col = 1; col <= 8; col++)
			{
				document.getElementById("layout-" + col + row).style.width = "45px";
				document.getElementById("layout-" + col + row).style.height = "9px";
			}
		}
	}
}

function UpdateLayout()
{
	var count = 0;
	for (var row = 1; row <= 8; row++)
	{
		if (row <= document.forms.customize.rows.value)
		{
			document.getElementById("layout-row-" + row).style.display = "";
			for (var col = 1; col <= 8; col++)
			{
				if (col <= document.forms.customize.cols.value)
				{
					document.getElementById("layout-" + col + row).style.backgroundColor = "#333333";
					document.getElementById("layout-image-" + col + row).src = number[count++].src;
				}
				else
				{
					document.getElementById("layout-" + col + row).style.backgroundColor = "#FFFFFF";
					document.getElementById("layout-image-" + col + row).src = "image/blank.png";
				}
			}
		}
		else
		{
			document.getElementById("layout-row-" + row).style.display = "none";
		}
	}
}

function UpdateTabs()
{
	document.forms.customize.pages.disabled = !document.getElementById("useTabs").checked;
	document.getElementById("tab-warning").style.display = document.getElementById("oneTab").checked ? "" : "none";
}

function ChangeLayout()
{
	document.forms.customize.cols.value = String(document.forms.customize.layout.value).charAt(0);
	document.forms.customize.rows.value = String(document.forms.customize.layout.value).charAt(2);
	document.forms.customize.count.value = Number(document.forms.customize.cols.value) * Number(document.forms.customize.rows.value);

	UpdateLayout();
	document.getElementById("layout-alert").style.display = ValidateTabs(false) ? "none" : "";
}

function ChangeTabs()
{
	document.forms.customize.tabs.value = document.getElementById("useTabs").checked ? document.forms.customize.pages.value : 
		(document.getElementById("oneTab").checked ? 1 : 0);

	UpdateTabs();
	document.getElementById("layout-alert").style.display = ValidateTabs(false) ? "none" : "";
}

function ValidateTabs(dialog)
{
	if (document.forms.customize.tabs.value > 1 && Number(document.forms.customize.count.value) * Number(document.forms.customize.tabs.value) > 12)
	{
		if (dialog) alert("Please decrease the number of pages or the number of timers per page.\n\nSingle page: can have up to 8 timers\n2 tabbed pages: can have up to 6 timers per page\n3 tabbed pages: can have up to 4 timers per page\n4 tabbed pages: can have up to 3 timers per page");
		return false;
	}

	return true;
}

function UpdateDimensions()
{
	var width = document.forms.customize.rotate.checked ? 22 : (Number(document.forms.customize.size.value) + 25);
	var height = document.forms.customize.rotate.checked ? (Number(document.forms.customize.size.value) + 25) : 22;
	
	width += Number(document.forms.customize.spacing.value);
	height += Number(document.forms.customize.spacing.value);
	
	width *= Number(document.forms.customize.cols.value);
	height *= Number(document.forms.customize.rows.value);
	
	width -= Number(document.forms.customize.spacing.value);
	height -= Number(document.forms.customize.spacing.value);
	
	if (document.forms.customize.tabs.value > 1) height += 22;

	document.forms.customize["dimensions-all"].value = width + " x " + height + " pixels (W x H).";
}

function DisableLayoutRequired()
{
	if (document.forms.customize["_layout"].value == "*") document.forms.customize.layout.disabled = true;
	if (document.forms.customize["_spacing"].value == "*") document.forms.customize.spacing.disabled = true;
}

function EnableLayoutRequired()
{
	if (document.forms.customize["_layout"].value == "*") document.forms.customize.layout.disabled = false;
	if (document.forms.customize["_spacing"].value == "*") document.forms.customize.spacing.disabled = false;
}

