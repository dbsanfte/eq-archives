function Edit(t)
{
	document.forms.customize.edit.value = t;
	LoadData(t);
	
	UpdateTimers();
	scrollTo(0, 0);
}

function OK()
{
	if (ValidateEdit())
	{
		SaveData(document.forms.customize.edit.value);
		document.forms.customize.edit.value = "";
		
		UpdateTimers();
		scrollTo(0, 0);
	}
}

function UpdateTimer(t)
{
	document.getElementById("color-" + t).style.backgroundColor = "#" + document.forms.customize["color." + t].value;
	
	document.getElementById("standard-" + t).style.display = document.forms.customize["marker." + t].value == "1" ? "" : "none";
	document.getElementById("split-" + t).style.display = document.forms.customize["marker." + t].value == "2" ? "" : "none";

	document.images["icon-" + t].src = "image/icon/" + document.forms.customize["icon-tga." + t].value + "/" +
		String(document.forms.customize["icon-x." + t].value) + String(document.forms.customize["icon-y." + t].value) + ".png";
}

function UpdateOverview()
{
	var tab = ["A", "B", "C", "D"];
	var pages = document.forms.customize.tabs.value;
	if (pages == 0) pages = 1;

	document.getElementById("tab-0").style.display = (document.forms.customize.tabs.value == 0) ? "none" : "";
	for (var p = 0; p < pages; p++)
	{
		if (p > 0)
			document.getElementById("tab-" + p).style.display = "";
		for (var t = 1; t <= document.forms.customize.count.value; t++)
		{
			if (t > 1)
				document.getElementById("timer-" + tab[p] + t).style.display = "";
				
			UpdateTimer(tab[p] + t);
		}
		if (t <= 8 && (p + 1) * t <= 12)
			document.getElementById("timer-" + tab[p] + t).style.display = "none";
	}
	if (pages < 4)
		document.getElementById("tab-" + pages).style.display = "none";
}

function UpdateTimers()
{
	if (document.forms.customize.edit.value == "")
	{
		document.forms.customize.back.style.display = document.forms.customize.next.style.display = "";
		document.forms.customize.style.display = "";
		document.getElementById("edit-view").style.display = "none";
		UpdateOverview();
	}
	else
	{
		document.forms.customize.back.style.display = document.forms.customize.next.style.display = "none";
		document.forms.customize.style.display = "none";
		document.getElementById("edit-view").style.display = "";
		UpdateEdit();
	}
}

function ValidateTab(tab)
{
	var name = document.forms.customize["tab." + tab].value;
	var pattern = /^[!-~]([!-~ ]{0,10}[!-~])?$/;

	if (pattern.test(name))
		return true;

	alert("Please enter a different tab name. Rules:\n- name must contain between 1 and 12 characters\n- only use characters found on a standard US keyboard\n- name cannot begin or end with a space");
	document.forms.customize["tab." + tab].select();
	return false;
}

function ValidateTimers()
{
	var tab = ["A", "B", "C", "D"];
	var pages = document.forms.customize.tabs.value;
	if (pages == 0) pages = 1;
	
	if (document.forms.customize.tabs.value > 0)
	{
		for (p = 0; p < pages; p++)
		{
			if (!ValidateTab(tab[p]))
				return false;
		}
	}
	
	for (p = 0; p < pages; p++)
	{
		for (t = 1; t <= document.forms.customize.count.value; t++)
		{
			if (document.forms.customize["duration." + tab[p] + t].value == 0)
			{
				alert("All timers must have durations greater than 0:00:00.\nPlease edit your timer properties accordingly.");
				return false;
			}
		}
	}
	
	return true;
}

