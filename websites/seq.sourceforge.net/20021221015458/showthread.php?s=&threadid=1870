	<font face="verdana, arial, helvetica" size="2" ><b>Khallus</b></font><br>
	<font face="verdana,arial,helvetica" size="1" >Blackburrow Gnoll</font><br>
	<p>
	<font face="verdana,arial,helvetica" size="1" >Registered: May 2002<br>
