var on_bulb = '<img src="http://www.vallisscortor.com/UBB/msgbrd/JCImages/gold_on.gif" border="0" alt="New Posts Since Your Last Visit" />';
var off_bulb = '<img src="http://www.vallisscortor.com/UBB/msgbrd/JCImages/gold_off.gif" border="0" alt="No New Posts Since Your Last Visit" />';

function bulbize(post_j) {
	if ((post_j > session_j) && (post_j != 0)) {
		return(on_bulb);
	}  else {
		return(off_bulb);
	}
}
