	document.write('</SCR' + 'IPT\> \n');
}
if (( MM_FlashCanPlay ) && (navigator.appVersion.indexOf("Win") != -1)) {
flash_list = function (flashdiv, listdiv) {
fl = document.getElementById(flashdiv); 
