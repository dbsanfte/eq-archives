fl.style.display = "block";
ls = document.getElementById(listdiv); 
ls.style.display = "none";
}
} 
else if (( MM_FlashCanPlay ) && (navigator.appVersion.indexOf("Mac") != -1)) {
flash_list = function (flashdiv, listdiv) {
fl = document.getElementById(flashdiv); 
fl.style.display = "block";
ls = document.getElementById(listdiv); 
ls.style.display = "none";
}
}
else {
flash_list = function (flashdiv, listdiv) {
fl = document.getElementById(flashdiv); 
fl.style.display = "none";
ls = document.getElementById(listdiv); 
ls.style.display = "block";
}
}
//Detect Flash END
function bork (flashdiv, listdiv) {
  if(document.getElementById(flashdiv)){
    flash_list(flashdiv, listdiv);
	}
  for(var i = 1; i <10 && document.getElementById(flashdiv + i); i++) {
	flash_list(flashdiv + i, listdiv + i);
	}
}

