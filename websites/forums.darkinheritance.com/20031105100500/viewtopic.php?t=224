				<td valign="top" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=1414&amp;sid=81654a0de8b1629390c40b1a1d6f2d3d"><img src="templates/smartDark/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
