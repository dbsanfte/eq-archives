				<td width="100%"><a href="viewtopic.php?p=2384&amp;sid=7f47ac5769e51859ef5bc3c1a4650737#2384"><img src="templates/smartDark/images/icon_minipost.gif" width="12" height="9" alt="Post" title="Post" border="0" /></a><span class="postdetails">Posted: Fri Apr 30, 2004 10:05 pm<span class="gen">&nbsp;</span>&nbsp; &nbsp;Post subject: Snide's Redemption: Episode 4</span></td>
				<td valign="top" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=2384&amp;sid=7f47ac5769e51859ef5bc3c1a4650737"><img src="templates/smartDark/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
