				<td valign="top" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=2412&amp;sid=7f47ac5769e51859ef5bc3c1a4650737"><img src="templates/smartDark/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
