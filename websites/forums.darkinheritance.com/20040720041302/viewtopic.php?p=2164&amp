				<td valign="top" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=1556&amp;sid=e8c27b4ee99e8792e3dc725da197550f"><img src="templates/smartDark/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
