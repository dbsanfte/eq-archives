			<blockquote>
												
			<form action="http://links.ganetwork.com/cgi-bin/add.cgi" method="POST">
			<p>Please fill out the form completely, and we'll add your resource as soon as possible.</p>
			<div class="margin">
			<table border ="0" cellspacing="0" cellpadding="0">
			<tr><td align="right" valign="top">Title:</td>
			<td><input name="Title" size="50"></td></tr>
			<tr><td align="right" valign="top">URL:</td>
			<td><input name="URL" size="50"></td></tr>
			<tr><td align="right" valign="top">Category:</td>
			<td><SELECT NAME="Category"  SIZE=1><OPTION>---<OPTION>Anarchy-Online<OPTION>EverQuest<OPTION>EverQuest/All_Purpose<OPTION>EverQuest/Classes<OPTION>EverQuest/Classes/Bard<OPTION>EverQuest/Classes/Cleric<OPTION>EverQuest/Classes/Druid<OPTION>EverQuest/Classes/Enchanter<OPTION>EverQuest/Classes/Magician<OPTION>EverQuest/Classes/Monk<OPTION>EverQuest/Classes/Necromancer<OPTION>EverQuest/Classes/Paladin<OPTION>EverQuest/Classes/Ranger<OPTION>EverQuest/Classes/Rogue<OPTION>EverQuest/Classes/Shadow_Knight<OPTION>EverQuest/Classes/Shaman<OPTION>EverQuest/Classes/Warrior<OPTION>EverQuest/Classes/Wizard<OPTION>EverQuest/Creative_Works<OPTION>EverQuest/Global_Community<OPTION>EverQuest/News<OPTION>EverQuest/Races<OPTION>EverQuest/Races/Barbarian<OPTION>EverQuest/Races/Dark_Elf<OPTION>EverQuest/Races/Dwarf<OPTION>EverQuest/Races/Erudite<OPTION>EverQuest/Races/Gnome<OPTION>EverQuest/Races/Half_Elf<OPTION>EverQuest/Races/Halfling<OPTION>EverQuest/Races/High_Elf<OPTION>EverQuest/Races/Human<OPTION>EverQuest/Races/Iksar<OPTION>EverQuest/Races/Ogre<OPTION>EverQuest/Races/Troll<OPTION>EverQuest/Races/Woodland_Elf<OPTION>EverQuest/Servers<OPTION>EverQuest/Servers/Bertoxxolous<OPTION>EverQuest/Servers/Brell_Serilis<OPTION>EverQuest/Servers/Bristlebane<OPTION>EverQuest/Servers/Cazic-Thule<OPTION>EverQuest/Servers/Druzzil_Ro<OPTION>EverQuest/Servers/Eci<OPTION>EverQuest/Servers/Erollisi_Marr<OPTION>EverQuest/Servers/Fennin_Ro<OPTION>EverQuest/Servers/Innoruuk<OPTION>EverQuest/Servers/Karana<OPTION>EverQuest/Servers/Lanys_T_Vyl<OPTION>EverQuest/Servers/Luclin<OPTION>EverQuest/Servers/Mithaniel_Marr<OPTION>EverQuest/Servers/Morell-Thule<OPTION>EverQuest/Servers/Povar<OPTION>EverQuest/Servers/Prexus<OPTION>EverQuest/Servers/Quellious<OPTION>EverQuest/Servers/Rallos_Zek<OPTION>EverQuest/Servers/Rodcet_Nife<OPTION>EverQuest/Servers/Saryrn<OPTION>EverQuest/Servers/Solusek_Ro<OPTION>EverQuest/Servers/Tallon_Zek<OPTION>EverQuest/Servers/Tarew_Marr<OPTION>EverQuest/Servers/Test_Server<OPTION>EverQuest/Servers/The_Nameless<OPTION>EverQuest/Servers/The_Rathe<OPTION>EverQuest/Servers/The_Seventh_Hammer<OPTION>EverQuest/Servers/The_Tribunal<OPTION>EverQuest/Servers/Torvonnilous<OPTION>EverQuest/Servers/Tunare<OPTION>EverQuest/Servers/Vallon_Zek<OPTION>EverQuest/Servers/Veeshan<OPTION>EverQuest/Servers/Xegony<OPTION>EverQuest/Spoiler_Sites<OPTION>EverQuest/Trade_Skills<OPTION>EverQuest/Trade_Skills/Alchemy<OPTION>EverQuest/Trade_Skills/Baking<OPTION>EverQuest/Trade_Skills/Brewing<OPTION>EverQuest/Trade_Skills/Fletching<OPTION>EverQuest/Trade_Skills/Jewelcraft<OPTION>EverQuest/Trade_Skills/Pottery<OPTION>EverQuest/Trade_Skills/Smithing<OPTION>EverQuest/Trade_Skills/Tailoring<OPTION>EverQuest/Trade_Skills/Tinkering<OPTION>General_Gaming<OPTION>Neocron<OPTION>NeverWinter_Nights<OPTION>Shadowbane<OPTION>Star_Wars_Online<OPTION>Ultima_Online_2</SELECT></td></tr>
			<tr><td align="right" valign="top">Description:</td>
			<td><textarea wrap="virtual" name="Description" value="" rows="3" cols="42"></textarea></td></tr>
			<tr><td align="right" valign="top">Contact Name:</td>
			<td><input name="Contact Name" value="" size="40"></td></tr>					           
			<tr><td align="right" valign="top">Contact Email:</td>
			<td><input name="Contact Email" value="" size="40"></td></tr>					           
			<tr><td></td><td><input type="SUBMIT" value="Add Resource"></td></tr>
			</table>
			</div>
			</form>
			
			<form action="http://links.ganetwork.com/cgi-bin/search.cgi" method="GET">
