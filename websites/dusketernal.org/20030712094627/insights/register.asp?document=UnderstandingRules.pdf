			<tr valign="top">
				<td id="mainbody"><p class="bodycopy"><span class="subhead1">Please Register<br></span>
				To download BeggsHeidt white papers, please provide your contact information.<br>
				All requested information is required.</p>
				
				
				<form NAME="wpregister" ACTION="register.asp?state=2&document=UnderstandingRules.pdf" METHOD="post">
				<table width="100%" cellspacing="0" cellpadding="0" border="0" class="listtable">
					<tr>
						<td width="3%"><span class="bodycopysans">&nbsp;*</span></td>
                      	<td width="20%"><span class="bodycopysans">Full Name:</span></td>
                      	<td width="77%"><INPUT size=25 name=txtName maxlength=50 value=""></td>
			        </tr>
       				<tr>
						<td width="3%"><span class="bodycopysans"><span class="bodycopysans">&nbsp;*</span></td>
                      	<td width="20%"><span class="bodycopysans">Title:</span></td>
                      	<td width="77%"><INPUT size=25 name=txtTitle maxlength=50 value=""></td>
					</tr>
        			<tr>
                    	<td width="3%"><span class="bodycopysans"><span class="bodycopysans">&nbsp;*</span></td>
                     	<td width="20%"><span class="bodycopysans">Company/Institution:</span></td>
                      	<td width="77%"><INPUT size=25 name=txtCompany maxlength=50 value=""></td>
					</tr>
       				<tr>
                    	<td width="3%"><span class="bodycopysans">&nbsp;*</span></td>
                     	<td width="20%"><span class="bodycopysans">Address:</span></td>
                      	<td width="77%"><INPUT size=40 name=txtAddress1 maxlength=50 value=""></td>
        			</tr>
        			<tr>
                    	<td width="3%"><span class="bodycopysans">&nbsp;</span></td>
                     	<td width="20%"><span class="bodycopysans">&nbsp;</span></td>
                      	<td width="77%"><INPUT size=30 name=txtAddress2 maxlength=50 value=""></td>
					</tr>
					<tr>
                    	<td width="3%"><span class="bodycopysans">&nbsp;</span></td>
                    	<td width="20%"><span class="bodycopysans">&nbsp;</span></td>
                      	<td width="77%"><INPUT size=30 name=txtAddress3 maxlength=50 value=""></td>
        			</tr>
        			<tr>
                    	<td width="3%"><span class="bodycopysans">&nbsp;*</span></td>
                      	<td width="20%"><span class="bodycopysans">City:</span></td>
                      	<td width="77%"><INPUT size=30 name=txtCity maxlength=50 value=""></td>
        			</tr>
        			<tr>
                    	<td width="3%"><span class="bodycopysans">&nbsp;*</span></td>
						<td width="20%"><span class="bodycopysans">State/Province:</span></td>
                      	<td width="77%"><INPUT size=10 name=txtStateProv maxlength=25 value=""></td>
        			</tr>
        			<tr>
                    	<td width="3%"><span class="bodycopysans">&nbsp;*</span></td>
                      	<td width="20%"><span class="bodycopysans">Zip/Postal Code:</span></td>
                      	<td width="77%"><INPUT size=10 name=txtZipCode maxlength=15 value=""></td>
        			</tr>
        			<tr>
                    	<td width="3%"><span class="bodycopysans">&nbsp;*</span></td>
                      	<td width="20%"><span class="bodycopysans">Country:</span></td>
                      	<td width="77%"><INPUT size=30 name=txtCountry maxlength=50 value=""></td>
        			</tr>
			        <tr>
            			<td width="3%"><span class="bodycopysans">&nbsp;</span></td>
        			</tr>
        			<tr>
                    	<td width="3%"><span class="bodycopysans">&nbsp;*</span></td>
                      	<td width="20%"><span class="bodycopysans">E-mail Address:</span></td>
                      	<td width="77%"><INPUT size=40 name=txtEmail maxlength=50 value=""></td>
        			</tr>
        			<tr>
                    	<td width="3%"><span class="bodycopysans">&nbsp;*</span></td>
                      	<td width="20%"><span class="bodycopysans">Daytime Phone:</span></td>
                      	<td width="77%"><INPUT size=15 name=txtPhone maxlength=25 value=""></td>
        			</tr>
        			<tr>
                    	<td width="3%"><span class="bodycopysans">&nbsp;</span></td>
                      	<td width="20%"><span class="bodycopysans">&nbsp;</span></td>
                      	<td width="77%"><INPUT type=submit value="Submit Registration" id=submit1 name=submit1>&nbsp;<a href="javascript:top.history.go(-1);"><INPUT type=button value="Cancel" id=cancel name=cancel></a></td>
        			</tr>
      			</table>
      			
				</form>
				
