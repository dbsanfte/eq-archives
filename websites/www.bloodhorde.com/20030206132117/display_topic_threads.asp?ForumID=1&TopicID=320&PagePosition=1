            <a href="http://www.silvart2.com" target="_blank"><img src="forum_images/homepage_icon.gif" width="14" height="14" border="0" alt="Visit Drakang's homepage" align="absmiddle"></a><a href="http://www.silvart2.com" target="_blank" style="font-size: 10px; font-style: italic;" title="Visit&nbsp;Drakang's&nbsp;Homepage">www</a> 
            
            <a href="post_message_form.asp?mode=quote&threadID=1279&ReturnPage=Thread&ForumID=1&TopicID=320&PagePosition=1"><img src="forum_images/quote_icon.gif" width="17" height="17" align="absmiddle" border="0" alt="Quote&nbsp;Drakang"></a><a href="post_message_form.asp?mode=quote&threadID=1279&ReturnPage=Thread&ForumID=1&TopicID=320&PagePosition=1"  target="_self" style="font-size: 10px; font-style: italic;" title="Quote&nbsp;Drakang">Quote</a> 
            
	  </td>
