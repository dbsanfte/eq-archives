<meta http-equiv="Content-Language" content="en-us">
<body link="#CCFFFF" vlink="#FFFFCC" alink="#FFCCCC" text="#FFFFFF" background="tov_images/Background.jpg" topmargin="50">
<p align="center"><b><font face="Arial Unicode MS" color="#CDB423">VIS MAIOR 
MEMBERSHIP APPLICATION</font></b></p>
<p align="center">&nbsp;</p>
<div align="center">
  <center>
  <form method="POST" action="recruitmail.asp" name="Recruiting">
    <table border="0" cellpadding="3" cellspacing="3" style="border-collapse: collapse" bordercolor="#111111" width="45%">
      <tr>
        <td width="15%" align="right" valign="top"><font face="Arial" size="2">
        Character
        Name</font></td>
        <td width="50%"><input type="text" name="Name" size="30"></td>
      </tr>
      <tr>
        <td width="15%" align="right" valign="top"><font face="Arial" size="2">
        Class</font></td>
        <td width="50%"><input type="text" name="Class" size="30"></td>
      </tr>
      <tr>
        <td width="15%" align="right" valign="top"><font face="Arial" size="2">
        Level</font></td>
        <td width="50%"><input type="text" name="Level" size="30"></td>
      </tr>
      <tr>
        <td width="15%" align="right" valign="top"><font face="Arial" size="2">
        AA Points</font></td>
        <td width="50%"><input type="text" name="AAPoints" size="30"></td>
      </tr>
      <tr>
        <td width="15%" align="right" valign="top"><font face="Arial" size="2">
        Connection Speed</font></td>
        <td width="50%"><select size="1" name="Connection" width="30">
        <option>Analog Modem (up to 56k)</option>
        <option>ISDN (up to 128k)</option>
        <option>DSL (up to 768/128)</option>
        <option>DSL (greater than 768/128)</option>
        <option>Cable Modem</option>
        <option>T1 or better</option>
        </select></td>
      </tr>
      <tr>
        <td width="15%" align="right" valign="top"><font face="Arial" size="2">
        Play Times</font></td>
        <td width="50%"><select size="1" name="PlayTime">
        <option>Morning</option>
        <option>Afternoon</option>
        <option>Early Evening</option>
        <option>Late Nights</option>
        <option>Sleep?  Work?  What are those?</option>
        </select></td>
      </tr>
      <tr>
        <td width="15%" align="right" valign="top"><font face="Arial" size="2">
        Time Zone</font></td>
        <td width="50%"><select size="1" name="TimeZone">
        <option>US West Coast / Hawaii</option>
        <option>US Central / Mountain</option>
        <option>US East Coast</option>
        <option>Western Europe</option>
        <option>Central / Eastern Europe</option>
        <option>Far East / Australia</option>
        </select></td>
      </tr>
      <tr>
        <td width="15%" align="right" valign="top"><font face="Arial" size="2">
        Why do you want to join Vis Maior?</font></td>
        <td width="50%"><textarea rows="10" name="Bio" cols="40"></textarea></td>
      </tr>
    </table>
    <p><input type="submit" value="Submit" name="B1"><input type="reset" value="Reset" name="B2"></p>
  </form>
  <p>&nbsp;</p>
  </center>
</div><head><title>Submit your Application to Vis Maior</title></head>