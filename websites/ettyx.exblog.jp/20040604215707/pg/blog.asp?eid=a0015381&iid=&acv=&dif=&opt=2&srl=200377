<DIV CLASS=POST_TAIL> <A HREF=http://ettyx.exblog.jp/183430/>#</A> <SPAN CLASS=TIME>by <SPAN CLASS=AUTHOR>ettyx</SPAN> | <A HREF=http://ettyx.exblog.jp/183430/>2004-04-21 13:16</A></SPAN> | <A HREF=#trb OnClick="trbview('183430','a0015381','ettyx%2Eexblog%2Ejp'); return false;"><B>Trackback<SPAN ID=trbcnt183430></SPAN></B></A> | <A HREF=#cmt OnClick="cmtview('183430','a0015381','ettyx%2Eexblog%2Ejp'); return false;"><B>Comments(<SPAN ID=cmtcnt183430>0</SPAN>)</B></A></DIV>
