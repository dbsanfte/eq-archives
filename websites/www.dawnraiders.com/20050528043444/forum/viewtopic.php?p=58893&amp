				<td valign="top" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=58773&amp;sid=537a775db915d6dd346df88b113a83c3"><img src="templates/subBlack/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
