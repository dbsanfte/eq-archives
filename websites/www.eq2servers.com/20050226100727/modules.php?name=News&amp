                    <tr>
                      <td nowrap><div align="left"><font class="storytitle"><b><a href="modules.php?name=News&amp;file=categories&amp;op=newindex&amp;catid=6"><font class="storycat">Official EQII News</font></a>: Moorgard: Reactives/Wards</b></font></div></td>
