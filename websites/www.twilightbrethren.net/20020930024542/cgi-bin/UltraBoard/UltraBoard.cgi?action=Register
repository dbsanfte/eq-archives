                <td width="150" valign="top" nowrap><font class="passwordbox">Password</font>&nbsp;<font class="required">*</font></td>
                <td width="60%" valign="top" nowrap><input type="password" name="FORM_PASSWORD" size="45" maxlength="16" class="passwordbox"></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-passwordbox">enter a password for your member account.</font></td></tr></table></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="passwordbox">Confirm Password</font>&nbsp;<font class="required">*</font></td>
                <td width="60%" valign="top" nowrap><input type="password" name="FORM_CONFIRM_PASSWORD" size="45" maxlength="16" class="passwordbox"></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-passwordbox">please re-enter your previous password for confirmation.</font></td></tr></table></td>
