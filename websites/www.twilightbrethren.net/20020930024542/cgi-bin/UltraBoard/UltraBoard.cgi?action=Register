        <tr class="body">
          <td width="100%">
            <table width="100%" cellspacing="0" cellpadding="2">
              <tr>
                <td width="100%" colspan="3"><font class="body">Please fill out all required (<font class="required">*</font>) fields.</font></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="textbox">Username</font>&nbsp;<font class="required">*</font></td>
                <td width="60%" valign="top" nowrap><input type="text" name="FORM_USERNAME" size="45" maxlength="16" class="textbox"></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-textbox">enter an username for your member account.</font></td></tr></table></td>
              </tr>
