                <td width="150" valign="top" nowrap><font class="textbox">Nickname</font>&nbsp;<font class="required">*</font></td>
                <td width="60%" valign="top" nowrap><input type="text" name="FORM_NICKNAME" size="45" maxlength="32" class="textbox"></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-textbox">enter a nickname that you want other members to see. (you can change it any time)</font></td></tr></table></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="textbox">Email</font>&nbsp;<font class="required">*</font></td>
                <td width="60%" valign="top" nowrap><input type="text" name="FORM_EMAIL" size="45" maxlength="64" class="textbox"></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-textbox">enter your real email address, so you can receive the login information from us.</font></td></tr></table></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap>&nbsp;</td>
                <td valign="top" width="100%" colspan="2"><table border="0" cellspacing="0" cellpadding="0"><tr><td><input type="checkbox" name="FORM_HIDE_EMAIL" value="1" class="checkbox"></td><td width="100%"><font class="body">Hide your email address?</font></td></tr></table></td>
                
              </tr>
              <tr>
                <td width="100%" colspan="3"><font class="body">&nbsp;</font></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="textbox">Age</font>&nbsp;</td>
                <td width="60%" valign="top" nowrap><input type="text" name="FORM_AGE" size="45" maxlength="2" class="textbox"></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-textbox">how old are you?.</font></td></tr></table></td>
              </tr>
              <tr>
                <td width="100%" colspan="3"><font class="body">&nbsp;</font></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="textbox">Homepage</font>&nbsp;</td>
                <td width="60%" valign="top" nowrap><input type="text" name="FORM_HOMEPAGE" size="45" maxlength="256" class="textbox"></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-textbox">your homepage address.</font></td></tr></table></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="textbox">Location</font>&nbsp;</td>
                <td width="60%" valign="top" nowrap><input type="text" name="FORM_LOCATION" size="45" maxlength="256" class="textbox"></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-textbox">your home address. city, state, and country...</font></td></tr></table></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="textbox">Occupation</font>&nbsp;</td>
                <td width="60%" valign="top" nowrap><input type="text" name="FORM_OCCUPATION" size="45" maxlength="256" class="textbox"></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-textbox">your occupation.</font></td></tr></table></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="textbox">Interests</font>&nbsp;</td>
                <td width="60%" valign="top" nowrap><input type="text" name="FORM_INTEREST" size="45" maxlength="256" class="textbox"></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-textbox">what interests do you have?</font></td></tr></table></td>
              </tr>
              <tr>
                <td width="150" valign="top" nowrap><font class="textbox">ICQ Number</font>&nbsp;</td>
                <td width="60%" valign="top" nowrap><input type="text" name="FORM_ICQ" size="45" maxlength="16" class="textbox"></td>
                <td width="40%" valign="top"><table width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td><font class="sub-textbox">your icq number.</font></td></tr></table></td>
              </tr>
