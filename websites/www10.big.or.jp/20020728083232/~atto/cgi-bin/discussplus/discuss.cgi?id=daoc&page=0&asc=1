				hour = "0" + hour;
			}
			if(min < 10)
			{
				min = "0" + min;
			}
			rr =  +month + "/" + date + "(" + week + ")" + " " + hour + ":" + min;
			if(( us )&&(dstoffset > 0))
			{
				rr = rr + " DST";
			}
			else
			{
				rr = rr + " ---";
			}
			return(rr);
		}
		now = new Date();
		yy  = now.getYear(); if(yy < 1900) yy += 1900;
