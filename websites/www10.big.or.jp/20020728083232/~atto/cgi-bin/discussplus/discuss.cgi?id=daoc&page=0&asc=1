				dstoffset = dst(t);
				t.setTime(t.getTime() + dstoffset);
			}
			month = t.getMonth() + 1;
			date  = t.getDate();
			hour  = t.getHours();
			min   = t.getMinutes();
week =day[t.getDay()];
