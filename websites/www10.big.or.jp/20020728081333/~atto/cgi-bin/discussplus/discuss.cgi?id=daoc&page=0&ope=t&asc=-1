		        tz_tmp = now.getTime() - Date.UTC(yy,mm,dd,hh,min,ss);
		        tz = Math.round(tz_tmp / 1000) * 1000;
		        return(tz);
		}
		function dst(lt)
		{
			if((lt.getTime() >= dstbegin.getTime())&&
			   (lt.getTime() <= dstend.getTime()))
			{
				return(3600000);
			}
			else
			{
				return(0);
			}
		}
		function dispclock()
		{
			now = new Date();
			tz_lc = gettz();
			document.form1.eastern.value  = calctime(now,tz_et,true);
			document.form1.gmt.value      = calctime(now,0,false);
			document.form1.japan.value    = calctime(now,tz_jp,false);
			setTimeout('dispclock()',1000);
		}
		function calctime(now,tz,us)
		{
var day = new Array("日","月","火","水","木","金","土");
			t = new Date();
			t.setTime(now.getTime() + (tz_lc - tz));
			if( us )
			{
				dstoffset = dst(t);
				t.setTime(t.getTime() + dstoffset);
			}
			month = t.getMonth() + 1;
			date  = t.getDate();
			hour  = t.getHours();
			min   = t.getMinutes();
week =day[t.getDay()];
			if(hour < 10)
			{
				hour = "0" + hour;
			}
			if(min < 10)
			{
				min = "0" + min;
			}
			rr =  +month + "/" + date + "(" + week + ")" + " " + hour + ":" + min;
			if(( us )&&(dstoffset > 0))
			{
				rr = rr + " DST";
			}
			else
			{
				rr = rr + " ---";
			}
			return(rr);
		}
		now = new Date();
		yy  = now.getYear(); if(yy < 1900) yy += 1900;
		apr = new Date(yy,3,7);
		firstsunday = 7 - apr.getDay();
		oct = new Date(yy,9,31);
		lastsunday = 31 - oct.getDay();
		dstbegin   = new Date(yy,3,firstsunday,2,0,0);
		dstend     = new Date(yy,9,lastsunday,1,0,0);
