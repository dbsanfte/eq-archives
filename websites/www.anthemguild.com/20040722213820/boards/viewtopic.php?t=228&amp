				<td valign="top" align="right" nowrap="nowrap"><a href="posting.php?mode=quote&amp;p=1179&amp;sid=15d6a36ae3a841c59603433c13a57f0d"><img src="templates/myth2/images/lang_english/icon_quote.gif" alt="Reply with quote" title="Reply with quote" border="0" /></a>   </td>
