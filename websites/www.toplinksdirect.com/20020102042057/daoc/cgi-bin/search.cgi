        <tr> 
          <td>&nbsp;</td>
          <td> 
            <table width="100%" border="0" cellspacing="0" cellpadding="0">
              <tr> 
                <td valign="top" width="100%"> 
                  <table width="100%" border="0" cellspacing="0" cellpadding="0">
                    <tr> 
                      <td bgcolor="#666666"> 
                        <table width="100%" border="0" cellspacing="1" cellpadding="3">
                          <tr> 
                            <td bgcolor="#99CC33"><b><font size="2" color="#FFFFFF"> 
                              Search Options</font></b></td>
                          </tr>
                        </table>
                      </td>
                    </tr>
                  </table>
                  <br>
                  <form action="http://www.toplinksdirect.com/daoc/cgi-bin/search.cgi" method="GET">
                    <div class="margin"> 
                      <table border="0" cellspacing="0" cellpadding="0" width="50" align="center">
                        <tr> 
                          <td bgcolor="#999999"> 
                            <table border="0" cellpadding="3" cellspacing="1">
                              <tr> 
                                <td colspan="2" bgcolor="#E2E2E2"><b><font size="2">Search:</font></b></td>
                              </tr>
                              <tr bgcolor="#CCCCCC"> 
                                <td colspan="2"> 
                                  <table border="0" cellspacing="0" cellpadding="1">
                                    <tr> 
                                      <td> 
                                        <input type="TEXT" name="query" size="25">
                                      </td>
                                      <td> 
                                        <input type="Submit" value="Search" name="Submit" class=buttonsearch>
                                      </td>
                                    </tr>
                                  </table>
                                </td>
                              </tr>
                              <tr> 
                                <td nowrap bgcolor="#E2E2E2"> 
                                  <input type="RADIO" class="radiohellgrau" name="type" value="keyword" CHECKED>
                                  <font size="1" class=small>As Keywords</font><br>
                                  <input type="RADIO" class=radiohellgrau name="type" value="phrase">
                                  <font size="1" class=small>As Phrase</font></td>
                                <td nowrap bgcolor="#E2E2E2"> 
                                  <input type="RADIO" class=radiohellgrau name="bool" value="and" CHECKED>
                                  <font size="1" class=small>AND connector</font><br>
                                  <input type="RADIO" name="bool" value="or" class=radiohellgrau>
                                  <font size="1" class=small>OR connector</font> 
                                </td>
                              </tr>
                              <tr bgcolor="#E2E2E2"> 
                                <td colspan="2"> 
                                  <table border="0" cellspacing="0" cellpadding="1">
                                    <tr> 
                                      <td nowrap><font size="1" class=small>Number 
                                        of Results: </font></td>
                                      <td nowrap> 
                                        <select name="mh">
                                          <option>10 
                                          <option SELECTED>25 
                                          <option>50 
                                          <option>100 
                                        </select>
                                      </td>
                                    </tr>
                                  </table>
                                </td>
                              </tr>
                            </table>
                          </td>
                        </tr>
                      </table>
                    </div>
                  </form>
                </td>
                <td width="15"><img src="http://www.toplinksdirect.com/daoc/tpl_images/spacer.gif" width="15" height="15"></td>
