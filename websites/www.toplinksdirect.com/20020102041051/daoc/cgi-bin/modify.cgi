</head>
<body bgcolor="#FFFFFF" text="#000000" background="http://www.toplinksdirect.com/daoc/tpl_images/background.gif" link="#333333" vlink="#333333" alink="#FFFFFF" leftmargin="0" topmargin="0" marginwidth="0" marginheight="0">
<table border="0" cellspacing="0" cellpadding="0" align="center" width="700">
  <tr> 
    <td bgcolor="#666666" width="1"><img src="pages/tpl_images/spacer.gif" width="1" height="1"></td>
    <td bgcolor="#DCDCDC" align="center"> 
      <table border="0" cellspacing="0" cellpadding="0" bgcolor="#E0E0E0">
        <tr> 
          <td><img src="http://www.toplinksdirect.com/daoc/tpl_images/spacer.gif" width="15" height="9"></td>
          <td></td>
          <td><img src="http://www.toplinksdirect.com/daoc/tpl_images/spacer.gif" width="15" height="15"></td>
        </tr>
        <tr> 
          <td>&nbsp;</td>
          <td>
            <p align="center"><img src="http://www.toplinksdirect.com/daoc/tpl_images/logo.gif"
          </td>
          <td>&nbsp;</td>
        </tr>
        <tr> 
          <td>&nbsp;</td>
          <td bgcolor="#666666"> 
            <table width="670" border="0" cellspacing="1" cellpadding="3">
              <tr> 
                <td bgcolor="#99CC33"> 
                  <table border="0" cellspacing="0" cellpadding="0" width="100%">
                    <tr> 
                      <td bgcolor="#666666"> 
                        <table border="0" cellspacing="1" cellpadding="0" width="100%">
                          <tr> 
                            <td height="17" background="http://www.toplinksdirect.com/daoc/tpl_images/button_bg.gif" align="center"><a href="http://www.toplinksdirect.com/daoc" class="menu">&nbsp;Home&nbsp;</a></td>
                            <td height="17" background="http://www.toplinksdirect.com/daoc/tpl_images/button_bg.gif" align="center"><a href="http://www.toplinksdirect.com/daoc/cgi-bin/add.cgi" class="menu">&nbsp;Add 
                              a Resource&nbsp;</a></td>
                            <td height="17" background="http://www.toplinksdirect.com/daoc/tpl_images/button_bg.gif" align="center"><a href="http://www.toplinksdirect.com/daoc/cgi-bin/modify.cgi" class="menu">&nbsp;Modify 
                              a Resource&nbsp;</a></td>
                            <td height="17" background="http://www.toplinksdirect.com/daoc/tpl_images/button_bg.gif" align="center"><a href="http://www.toplinksdirect.com/daoc/New" class="menu">&nbsp;What's 
                              New&nbsp;</a></td>
                            <td height="17" background="http://www.toplinksdirect.com/daoc/tpl_images/button_bg.gif" align="center"><a href="http://www.toplinksdirect.com/daoc/Cool" class="menu">&nbsp;What's 
                              Cool&nbsp;</a></td>
                            <td height="17" background="http://www.toplinksdirect.com/daoc/tpl_images/button_bg.gif" align="center"><a href="http://www.toplinksdirect.com/daoc/Ratings" class="menu">&nbsp;Top 
                              Rated&nbsp;</a></td>
                            <td height="17" background="http://www.toplinksdirect.com/daoc/tpl_images/button_bg.gif" align="center"><a href="http://www.toplinksdirect.com/daoc/cgi-bin/subscribe.cgi" class="menu">&nbsp;Email 
                              Updates&nbsp;</a></td>
                            <td height="17" background="http://www.toplinksdirect.com/daoc/tpl_images/button_bg.gif" align="center"><a href="http://www.toplinksdirect.com/daoc/cgi-bin/jump.cgi?ID=random" class="menu">&nbsp;Random 
                              Link&nbsp;</a></td>
                          </tr>
                        </table>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>
          </td>
          <td>&nbsp;</td>
        </tr>
        <tr> 
          <td><img src="http://www.toplinksdirect.com/daoc/tpl_images/spacer.gif" width="15" height="30"></td>
          <td>&nbsp;</td>
          <td>&nbsp;</td>
        </tr>
        <tr> 
          <td>&nbsp;</td>
          <td> 
            <table width="100%" border="0" cellspacing="0" cellpadding="0">
              <tr> 
                <td valign="top"> 
                  <table width="100%" border="0" cellspacing="0" cellpadding="0">
                    <tr> 
                      <td bgcolor="#666666"> 
                        <table width="100%" border="0" cellspacing="1" cellpadding="3">
                          <tr> 
                            <td bgcolor="#99CC33"><b><font size="2" color="#FFFFFF">Modify 
                              a Resource</font></b></td>
                          </tr>
                        </table>
                      </td>
                    </tr>
                  </table>
                  <br>
                  <form action="http://www.toplinksdirect.com/daoc/cgi-bin/modify.cgi" method="POST">
                    <p> 
                    <p><font size="2">Please enter the URL of the link you wish 
                      to update. Make sure it is identical to the one already 
                      in the database:</font></p>
                    <div class="margin"> 
                      <input name="Current URL" size="30">
                    </div>
                    <p><font size="2">Now enter the new information (all of it, 
                      not just the changes) below:</font></p>
                    <table border ="0" cellspacing="1" cellpadding="3">
                      <tr> 
                        <td valign="top" nowrap><b><font size="2">Title:</font></b></td>
                        <td valign="top"> 
                          <input name="Title" size="30">
                        </td>
                      </tr>
                      <tr> 
                        <td valign="top" nowrap><b><font size="2">URL:</font></b></td>
                        <td valign="top"> 
                          <input name="URL" size="30">
                        </td>
                      </tr>
                      <tr> 
                        <td valign="top" nowrap><b><font size="2">Category:</font></b></td>
                        <td valign="top"><font size="2"> 
                          <SELECT NAME="Category"  SIZE=1><OPTION>---<OPTION>Forums<OPTION>General_Sites<OPTION>Guild_Sites<OPTION>Guild_Sites/Albion<OPTION>Guild_Sites/Hibernia<OPTION>Guild_Sites/Midgard<OPTION>Mailing_Lists<OPTION>Map-Zone_Sites<OPTION>Other_Link_Sites<OPTION>Realm_Sites<OPTION>Realm_Sites/Britons<OPTION>Realm_Sites/Hibernians<OPTION>Realm_Sites/Norse<OPTION>Roleplaying<OPTION>Trade-Auction_Sites<OPTION>Web_Rings</SELECT>
                          </font></td>
                      </tr>
                      <tr> 
                        <td valign="top" nowrap><b><font size="2">Description:</font></b></td>
                        <td valign="top"> 
                          <textarea wrap="virtual" name="Description" value="" rows="5" cols="35"></textarea>
                        </td>
                      </tr>
                      <tr> 
                        <td valign="top" nowrap><b><font size="2">Contact Name:</font></b></td>
                        <td valign="top"> 
                          <input name="Contact Name" value="" size="30">
                        </td>
                      </tr>
                      <tr> 
                        <td valign="top" nowrap><b><font size="2">Contact Email:</font></b></td>
                        <td valign="top"> 
                          <input name="Contact Email" value="" size="30">
                        </td>
                      </tr>
                      <tr> 
                        <td></td>
                        <td> 
                          <input type="SUBMIT" value="Modify Resource" name="SUBMIT" class=button>
                        </td>
                      </tr>
                    </table>
                  </form>
                </td>
                <td width="15"><img src="http://www.toplinksdirect.com/daoc/tpl_images/spacer.gif" width="15" height="15"></td>
                <td width="175" valign="top" align="right"> 
                  <table width="175" border="0" cellspacing="0" cellpadding="0">
                    <tr> 
                      <td bgcolor="#666666"> 
                        <table width="175" border="0" cellspacing="1" cellpadding="3">
                          <tr> 
                            <td bgcolor="#CCCCCC"><b><font size="2">Search</font></b></td>
                          </tr>
                          <tr> 
                            <td bgcolor="#E2E2E2"> 
                              <form action="http://www.toplinksdirect.com/daoc/cgi-bin/search.cgi" method="GET">
                                <table border="0" cellspacing="1" cellpadding="3">
                                  <tr> 
                                    <td> 
                                      <input type="text" size=18 name="query">
                                    </td>
                                  </tr>
                                  <tr> 
                                    <td> 
                                      <input type=submit value="Search!" name="submit" class=buttonsearch>
                                    </td>
                                  </tr>
                                  <tr> 
                                    <td><a href="http://www.toplinksdirect.com/daoc/cgi-bin/search.cgi"><font size="1" class=footer>More 
                                      search options</font></a></td>
                                  </tr>
                                </table>
                              </form>
                            </td>
                          </tr>
                        </table>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>
          </td>
          <td>&nbsp;</td>
        </tr>
