          <td bgcolor="#808080" width="1"><img src="http://www.toplinksdirect.com/tpl_images/spacer.gif" width="1" height="1"></td>
          <td width="563" bgcolor="#FFFFFF"> 
            <table width="563" border="0" cellspacing="0" cellpadding="0">
              <tr> 
                <td bgcolor="#CCCCCC" valign="top"><img src="http://www.toplinksdirect.com/tpl_images/spacer.gif" width="10" height="10"></td>
                <td bgcolor="#CCCCCC" width="100%" height="18"><font size="1"><b>Add 
                  a Resource</b></font></td>
                <td bgcolor="#CCCCCC" valign="top"><img src="http://www.toplinksdirect.com/tpl_images/spacer.gif" width="10" height="10"></td>
              </tr>
              <tr bgcolor="#808080"> 
                <td colspan="3"><img src="http://www.toplinksdirect.com/tpl_images/spacer.gif" width="1" height="1"></td>
              </tr>
              <tr> 
                <td bgcolor="#FFFFFF">&nbsp;</td>
                <td bgcolor="#FFFFFF"><br>
                  <font size="2">Please fill out the form completely, and we'll 
                  add your resource as soon as possible.</font> 
                  <form action="http://www.toplinksdirect.com/cgi-bin/add.cgi" method="POST">
                    <p> 
                    <table border ="0" cellspacing="1" cellpadding="3">
                      <tr> 
                        <td valign="top" nowrap><b><font size="2">Title:</font></b></td>
                        <td valign="top"> 
                          <input name="Title" size="30">
                        </td>
                      </tr>
                      <tr> 
                        <td valign="top" nowrap><b><font size="2">URL:</font></b></td>
                        <td valign="top"> 
                          <input name="URL" size="30">
                        </td>
                      </tr>
                      <tr> 
                        <td valign="top" nowrap><b><font size="2">Category:</font></b></td>
                        <td valign="top"><font size="2"> 
                          <SELECT NAME="Category"  SIZE=1><OPTION>---<OPTION>Ages_of_Athiria<OPTION>Anachronox<OPTION>Anarchy_Online<OPTION>Arcanity<OPTION>Arcanum<OPTION>Archaean<OPTION>Arx_Fatalis<OPTION>Asherons_Call<OPTION>Atriarch<OPTION>Ballerium<OPTION>BigWorld<OPTION>Black_Moon_Chronicles<OPTION>Black_and_White<OPTION>Caeron3000<OPTION>Citizen_Zero<OPTION>City_of_Heroes<OPTION>DarK_Age_of_Camelot<OPTION>Darkfall_Online<OPTION>Demise<OPTION>Destiny_Online<OPTION>Deus_Ex<OPTION>Divine_Divinity<OPTION>Dominion<OPTION>Dominus_Online<OPTION>Dragon_Empires<OPTION>Dune_Generations<OPTION>Dungeon_Siege<OPTION>Earth_and_Beyond<OPTION>Elemental_Saga<OPTION>Eve<OPTION>EverQuest<OPTION>Evil_Islands<OPTION>FreeWorld<OPTION>Gothic<OPTION>Gundam_Online<OPTION>Heros_Journey<OPTION>Horizons<OPTION>Icewind_Dale<OPTION>Lost_Continents<OPTION>Meridian_59<OPTION>Middle_Earth<OPTION>Midgard<OPTION>Mimesis_Online<OPTION>Morrowind<OPTION>Neocron<OPTION>Neverwinter_Nights<OPTION>Pool_of_Radiance<OPTION>Project_Ego<OPTION>Project_Entropia<OPTION>Redguard<OPTION>Sea_Dogs<OPTION>Shadowbane<OPTION>Star_Wars_Galaxies<OPTION>Star_Wars_RPG<OPTION>Summoner<OPTION>The_4th_Coming<OPTION>The_4th_Prophecy<OPTION>The_After<OPTION>Throne_of_Darkness<OPTION>Ultima_Online<OPTION>Underlight<OPTION>Wizardry_8<OPTION>Wizards_and_Warriors<OPTION>World_of_Warcraft</SELECT>
                          </font></td>
                      </tr>
                      <tr> 
                        <td valign="top" nowrap><b><font size="2">Description:</font></b></td>
                        <td valign="top"> 
                          <textarea wrap="virtual" name="Description" value="" rows="5" cols="35"></textarea>
                        </td>
                      </tr>
                      <tr> 
                        <td valign="top" nowrap><b><font size="2">Contact Name:</font></b></td>
                        <td valign="top"> 
                          <input name="Contact Name" size="30">
                        </td>
                      </tr>
                      <tr> 
                        <td valign="top" nowrap><b><font size="2">Contact Email:</font></b></td>
                        <td valign="top"> 
                          <input name="Contact Email" size="30">
                        </td>
                      </tr>
                      <tr> 
                        <td></td>
                        <td> 
                          <input type="SUBMIT" value="Add Resource" name="SUBMIT" class=button>
                        </td>
                      </tr>
                    </table>
                  </form>
                  <br>
