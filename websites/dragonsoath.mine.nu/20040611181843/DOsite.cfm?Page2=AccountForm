    if  (!_CF_hasValue(_CF_this.EMAIL, "TEXT" )) 
        {
        if  (!_CF_onError(_CF_this, _CF_this.EMAIL, _CF_this.EMAIL.value, "Please Enter an Email address"))
            {
            return false; 
            }
        }

    if  (!_CF_hasValue(_CF_this.PASSWORD, "PASSWORD" )) 
        {
        if  (!_CF_onError(_CF_this, _CF_this.PASSWORD, _CF_this.PASSWORD.value, "Please Enter a Password"))
            {
            return false; 
            }
        }

    if  (!_CF_hasValue(_CF_this.VERIFYPASSWORD, "PASSWORD" )) 
        {
        if  (!_CF_onError(_CF_this, _CF_this.VERIFYPASSWORD, _CF_this.VERIFYPASSWORD.value, "Please Enter a Password"))
            {
            return false; 
            }
        }

    if  (!_CF_checkphone(_CF_this.TELEPHONE.value))
        {
        if  (!_CF_onError(_CF_this, _CF_this.TELEPHONE, _CF_this.TELEPHONE.value, "Please check the Telephone field"))
            {
            return false; 
            }
        }

return checkForm()
    return true;
    }

//-->
</script>
