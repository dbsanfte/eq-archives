                      <td width="32%" valign="middle"> 
                        <div align="right"><font size="1" color="#CCCCCC" face="Verdana, Arial, Helvetica, sans-serif">11/3/2002 7:01:50 PM PST</font><font size="1" color="#999999" face="Verdana, Arial, Helvetica, sans-serif">&nbsp;</font></div>
