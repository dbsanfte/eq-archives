                      <td width="32%" valign="middle"> 
                        <div align="right"><font size="1" color="#CCCCCC" face="Verdana, Arial, Helvetica, sans-serif">11/6/2002 3:43:41 AM PST</font><font size="1" color="#999999" face="Verdana, Arial, Helvetica, sans-serif">&nbsp;</font></div>
