          <td colspan="2" height="30" background="newsheader.jpg"><font face="Times New Roman" size="4"><b><font size="5">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Kael Excursion Includes the Famous AoW!</font></b></font></td>
        </tr>
        <tr bgcolor="#330033"> 
          <td width="60%"><font size="2"><i><font face="Verdana">by <A href="javascript:createWindow('memberdetails.asp?id=227','profile','scrollbars,width=550,height=500')"><font color=yellow>Lucane Darkseraphim</font></a></font></i></font></td>
